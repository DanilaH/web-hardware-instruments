www.hardwareinspect.com {
  redir https://hardwareinspect.com{uri} 308
}

hardwareinspect.com {
  root * /srv/hardwareinspect/current
  encode zstd gzip

  # Keep one public URL form: apex HTTPS, no .html suffix, no trailing slash.
  @indexHtml path /index.html
  redir @indexHtml /{?query} 308

  @htmlPath {
    not path /index.html
    path_regexp htmlPath ^(.+)\.html$
  }
  redir @htmlPath {re.htmlPath.1}{?query} 308

  @trailingSlash path_regexp trailingSlash ^(.+)/$
  redir @trailingSlash {re.trailingSlash.1}{?query} 308

  # Astro/Vite fingerprints these assets, so they can be cached immutably.
  header /_astro/* Cache-Control "public, max-age=31536000, immutable"

  # Astro file-format builds emit routes as .html files. Resolve the clean
  # canonical URL internally without exposing the file extension.
  try_files {path}.html {path} =404
  file_server

  handle_errors {
    rewrite * /404.html
    file_server
  }
}
