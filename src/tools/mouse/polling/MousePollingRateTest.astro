---
import ToolShell from '../../../components/tool-shell/ToolShell.astro';
---
<ToolShell labelledBy="polling-heading"><h2 id="polling-heading" class="sr-only">Mouse Polling Rate Test</h2><div class="polling-test" data-mouse-polling-test><div class="status"><span aria-hidden="true"></span><strong data-polling-status role="status" aria-live="polite">Ready to measure</strong></div><p class="instruction">Move continuously inside the area, then start the 2-second test.</p><div class="surface"><div class="move-field" data-polling-surface aria-label="Mouse movement sampling area"><span aria-hidden="true">MOVE CONTINUOUSLY</span><i aria-hidden="true"></i></div><div class="result"><span>Observed pointer sample rate</span><strong data-polling-rate>—</strong><dl><div><dt>Source</dt><dd data-polling-source>Waiting</dd></div></dl><button type="button" data-polling-start>Start 2-second test</button></div></div><p class="note">Browsers and operating systems can merge, limit, or reschedule pointer events, so this may differ from the mouse's configured hardware polling rate.</p></div></ToolShell>
<script>import{mountMousePollingTest}from'./mouse-polling-controller';const root=document.querySelector<HTMLElement>('[data-mouse-polling-test]');if(root){const c=mountMousePollingTest(root);window.addEventListener('pagehide',(e)=>e.persisted?c.stop():c.destroy());}</script>
<style>.polling-test{display:grid;gap:var(--space-4)}.status{display:flex;align-items:center;gap:.55rem;color:var(--color-muted);font-size:.88rem}.status span{width:.55rem;height:.55rem;border-radius:50%;background:var(--color-signal)}.instruction,.note{margin:0}.surface{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(19rem,.75fr);gap:var(--space-5);padding:var(--space-4);border:1px solid #e3e6e7;background:#fafbfb;user-select:none}.move-field{min-height:17rem;display:grid;place-items:center;position:relative;overflow:hidden;border:1px solid #dfe3e4;background-image:linear-gradient(#f0f2f2 1px,transparent 1px),linear-gradient(90deg,#f0f2f2 1px,transparent 1px);background-size:32px 32px;color:var(--color-muted);font:600 .72rem var(--font-mono);letter-spacing:.08em}.move-field i{position:absolute;width:55%;height:1px;background:var(--color-signal);opacity:.55}.result{display:grid;align-content:center;gap:var(--space-3);padding-left:var(--space-5);border-left:1px solid #dfe3e4}.result>span,.result dt{color:var(--color-muted);font-size:.72rem;font-weight:600;text-transform:uppercase}.result>strong{font:650 clamp(2.3rem,5vw,4rem)/1 var(--font-mono)}dl{margin:0}dl div{display:grid;gap:.25rem}dd{margin:0;font-size:.9rem}button{justify-self:start;padding:.65rem .9rem;border:1px solid var(--color-border);background:#fff;cursor:pointer}button:disabled{cursor:not-allowed;opacity:.55}.note{color:var(--color-muted);font-size:.75rem;line-height:1.45}.sr-only{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@media(max-width:48rem){.surface{grid-template-columns:1fr}.result{padding:var(--space-4) 0 0;border-left:0;border-top:1px solid #dfe3e4}.move-field{min-height:12rem}}@media(max-width:40rem){.surface{padding:var(--space-3)}.move-field{min-height:9rem}}
</style>
