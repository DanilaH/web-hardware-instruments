---
import RelatedTools from '../components/navigation/RelatedTools.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import DoubleClickTest from '../tools/mouse/double-click/DoubleClickTest.astro';

const relatedTools = [
  {
    href: '/mouse-button-test',
    name: 'Mouse Button Test',
    description: 'Check which semantic mouse button roles the browser receives.',
  },
  {
    href: '/mouse-tester',
    name: 'Mouse Tester',
    description: 'Check buttons, wheel input, and movement together.',
  },
] as const;
---

<BaseLayout
  title="Double Click Test — Check Mouse Double-Clicking"
  description="Click slowly and check whether this browser observes unusually fast repeated presses from the same mouse button."
  canonicalPath="/double-click-test"
>
  <section class="reading-width">
    <h1 class="page-heading">Double Click Test</h1>
    <p class="page-intro">Look for unusually fast repeated browser presses while you deliberately click slowly.</p>
  </section>

  <DoubleClickTest />

  <section class="tool-content reading-width">
    <h2>How the test works</h2>
    <p>
      The tool measures time between consecutive button-down events for the same semantic button. Gaps of 50 ms or less are counted as rapid repeats.
    </p>

    <h2>What the result does not prove</h2>
    <p>
      The 50 ms threshold is a conservative diagnostic heuristic, not a hardware standard. A rapid repeat can be worth investigating, but this browser test cannot prove switch chatter or declare the mouse broken.
    </p>
  </section>

  <RelatedTools tools={relatedTools} />
</BaseLayout>

<style>
  .tool-content {
    margin-top: var(--space-7);
    padding-bottom: var(--space-7);
  }

  .tool-content h2 {
    margin: var(--space-6) 0 var(--space-2);
    font-size: 1.15rem;
  }

  .tool-content p {
    color: var(--color-muted);
    line-height: 1.65;
  }
</style>
