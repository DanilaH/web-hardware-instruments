---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — Hardware Tests"
  description="About these lightweight browser-based hardware diagnostic tools."
  canonicalPath="/about"
>
  <article class="reading-width">
    <h1 class="page-heading">About</h1>
    <p class="page-intro">Hardware Tests is a collection of focused diagnostics that use browser-visible device and rendering signals.</p>

    <p>Each tool is designed to solve one task without an account, installation, or backend service.</p>
    <p>Browser APIs have real limits, so results are described as observed or estimated whenever the browser cannot expose exact hardware values.</p>
  </article>
</BaseLayout>
