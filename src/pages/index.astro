---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Hardware Tests in Your Browser"
  description="Lightweight browser-based hardware diagnostics. No install or account required."
  canonicalPath="/"
>
  <section class="home-intro reading-width">
    <h1 class="page-heading">Hardware Tests in Your Browser</h1>
    <p class="page-intro">Small, focused diagnostics that run directly in your browser.</p>
  </section>

  <section class="home-tools" aria-labelledby="available-tools">
    <h2 id="available-tools">Available tool</h2>
    <a class="tool-link" href="/gamepad-tester">
      <span class="tool-link__glyph" aria-hidden="true">+</span>
      <span>
        <strong>Gamepad Tester</strong>
        <small>Test controller buttons, sticks, D-pad, and triggers.</small>
      </span>
      <span class="tool-link__arrow" aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>

<style>
  .home-tools {
    max-width: 34rem;
    margin-top: var(--space-6);
  }

  .home-tools h2 {
    margin: 0 0 var(--space-3);
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .tool-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: var(--space-4);
    text-decoration: none;
  }

  .tool-link:hover {
    border-color: color-mix(in srgb, var(--color-signal) 50%, var(--color-border));
  }

  .tool-link__glyph {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-signal);
    font: 1.2rem/1 var(--font-mono);
  }

  .tool-link strong,
  .tool-link small {
    display: block;
  }

  .tool-link small {
    margin-top: 0.15rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .tool-link__arrow {
    color: var(--color-muted);
  }
</style>
