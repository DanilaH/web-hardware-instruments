---
import BaseLayout from '../layouts/BaseLayout.astro';

const controllerTools = [
  {
    href: '/gamepad-tester',
    glyph: 'G',
    name: 'Gamepad Tester',
    description: 'Test controller buttons, sticks, D-pad, and triggers.',
  },
  {
    href: '/controller-stick-drift-test',
    glyph: '↔',
    name: 'Controller Stick Drift Test',
    description: 'Measure observed analog-stick center offset while untouched.',
  },
  {
    href: '/controller-deadzone-test',
    glyph: '○',
    name: 'Controller Deadzone Test',
    description: 'Measure stick center noise and a heuristic starting deadzone.',
  },
] as const;

const mouseTools = [
  {
    href: '/mouse-tester',
    glyph: 'M',
    name: 'Mouse Tester',
    description: 'Check browser-detected mouse buttons, wheel input, and movement.',
  },
  {
    href: '/mouse-button-test',
    glyph: 'BTN',
    name: 'Mouse Button Test',
    description: 'Check primary, middle, secondary, back, and forward button input.',
  },
  {
    href: '/mouse-scroll-test',
    glyph: '↕',
    name: 'Mouse Scroll Test',
    description: 'Inspect browser-detected wheel directions and recent events.',
  },
  {
    href: '/double-click-test',
    glyph: '2×',
    name: 'Double Click Test',
    description: 'Look for unusually fast repeated same-button presses.',
  },
  {
    href: '/mouse-polling-rate-test',
    glyph: 'Hz',
    name: 'Mouse Polling Rate Test',
    description: 'Measure the pointer sample rate observed by this browser.',
  },
  {
    href: '/mouse-dpi-test',
    glyph: 'DPI',
    name: 'Mouse DPI Test',
    description: 'Estimate mouse DPI from a measured physical movement distance.',
  },
] as const;

const keyboardTools = [
  {
    href: '/keyboard-tester',
    glyph: 'K',
    name: 'Keyboard Tester',
    description: 'Press keys and see which physical key codes the browser detects.',
  },
  {
    href: '/keyboard-rollover-test',
    glyph: 'K+',
    name: 'Keyboard Rollover Test',
    description: 'See the largest simultaneous key set this browser detects.',
  },
  {
    href: '/keyboard-ghosting-test',
    glyph: 'KG',
    name: 'Keyboard Ghosting Test',
    description: 'Compare guided key combinations with the keys detected together.',
  },
] as const;

const displayTools = [
  {
    href: '/fps-test',
    glyph: 'F',
    name: 'FPS Test',
    description: 'Observe this browser page’s frame delivery and recent drops.',
  },
  {
    href: '/refresh-rate-test',
    glyph: 'Hz',
    name: 'Refresh Rate Test',
    description: 'Estimate the display cadence currently visible to the browser.',
  },
  {
    href: '/frame-skipping-test',
    glyph: 'FS',
    name: 'Frame Skipping Test',
    description: 'Use a camera-assisted pattern to look for repeatable skipped-refresh gaps.',
  },
  {
    href: '/dead-pixel-test',
    glyph: 'PX',
    name: 'Dead Pixel Test',
    description: 'Inspect the screen against solid colors for dead or stuck pixels.',
  },
  {
    href: '/backlight-bleed-test',
    glyph: 'BL',
    name: 'Backlight Bleed Test',
    description: 'Inspect a backlit display for bright leakage on a black screen.',
  },
] as const;

const touchTools = [
  {
    href: '/touch-screen-test',
    glyph: 'T',
    name: 'Touch Screen Test',
    description: 'Map browser-detected finger coverage, multi-touch, and unexpected touch input.',
  },
] as const;

const columns = [
  [
    { name: 'Controller', tools: controllerTools },
    { name: 'Mouse', tools: mouseTools },
  ],
  [
    { name: 'Keyboard', tools: keyboardTools },
    { name: 'Display', tools: displayTools },
    { name: 'Touch', tools: touchTools },
  ],
] as const;
---

<BaseLayout
  title="Hardware Tests in Your Browser"
  description="Lightweight browser-based hardware diagnostics. No install or account required."
  canonicalPath="/"
>
  <section class="home-intro reading-width">
    <h1 class="page-heading">Hardware Tests in Your Browser</h1>
    <p class="page-intro">Small, focused diagnostics that run directly in your browser.</p>
  </section>

  <section class="home-tools" aria-labelledby="available-tools">
    <h2 id="available-tools" class="home-tools__heading">Available tools</h2>
    <div class="tool-columns">
      {columns.map((column) => (
        <div class="tool-column">
          {column.map((group) => (
            <section class="tool-group" aria-labelledby={`tool-group-${group.name.toLowerCase()}`}>
              <h3 id={`tool-group-${group.name.toLowerCase()}`}>{group.name}</h3>
              <div class="tool-list">
                {group.tools.map((tool) => (
                  <a class="tool-link" href={tool.href}>
                    <span class="tool-link__glyph" aria-hidden="true">{tool.glyph}</span>
                    <span class="tool-link__copy">
                      <strong>{tool.name}</strong>
                      <small>{tool.description}</small>
                    </span>
                    <span class="tool-link__arrow" aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .home-tools {
    margin-top: var(--space-6);
  }

  .home-tools__heading,
  .tool-group h3 {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .home-tools__heading {
    margin: 0 0 var(--space-3);
  }

  .tool-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-6);
  }

  .tool-column {
    min-width: 0;
    display: grid;
    gap: var(--space-5);
  }

  .tool-group {
    min-width: 0;
  }

  .tool-group h3 {
    margin: 0 0 var(--space-2);
  }

  .tool-list {
    display: grid;
    gap: var(--space-2);
  }

  .tool-link {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: 0.72rem var(--space-3);
    text-decoration: none;
  }

  .tool-link:hover {
    border-color: color-mix(in srgb, var(--color-signal) 50%, var(--color-border));
  }

  .tool-link__glyph {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-signal);
    font: 0.74rem/1 var(--font-mono);
  }

  .tool-link__copy {
    min-width: 0;
  }

  .tool-link strong,
  .tool-link small {
    display: block;
  }

  .tool-link strong {
    font-size: 0.92rem;
    line-height: 1.25;
  }

  .tool-link small {
    margin-top: 0.08rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.3;
  }

  .tool-link__arrow {
    color: var(--color-muted);
  }

  @media (max-width: 52rem) {
    .tool-columns {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  @media (max-width: 40rem) {
    .home-tools {
      margin-top: var(--space-5);
    }

    .tool-column {
      gap: var(--space-4);
    }

    .tool-link {
      padding: var(--space-3);
    }
  }
</style>
