---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy — Hardware Tests"
  description="Privacy information for Hardware Tests browser diagnostics."
  canonicalPath="/privacy"
>
  <article class="reading-width">
    <h1 class="page-heading">Privacy</h1>
    <p class="page-intro">The diagnostics are designed to run locally in your browser.</p>

    <p>Raw controller, keyboard, mouse, and frame-timing streams are not intended to be uploaded or stored by the site.</p>
    <p>No account or sign-in is required. If lightweight analytics are introduced later, this page must be updated to describe the production behavior accurately.</p>
  </article>
</BaseLayout>
