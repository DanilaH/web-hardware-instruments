---
interface RelatedTool {
  href: string;
  name: string;
  description: string;
}

interface Props {
  tools: readonly RelatedTool[];
}

const { tools } = Astro.props;
---

<nav class="related-tools reading-width" aria-label="Related tools">
  <h2>Related tools</h2>
  <div class="related-tools__list">
    {tools.map((tool) => (
      <a class="related-tools__link" href={tool.href}>
        <span>
          <strong>{tool.name}</strong>
          <small>{tool.description}</small>
        </span>
        <span aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .related-tools {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .related-tools h2 {
    margin: 0 0 var(--space-3);
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .related-tools__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .related-tools__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
  }

  .related-tools__link:hover {
    border-color: color-mix(in srgb, var(--color-signal) 50%, var(--color-border));
  }

  .related-tools__link strong,
  .related-tools__link small {
    display: block;
  }

  .related-tools__link small {
    margin-top: 0.15rem;
    color: var(--color-muted);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .related-tools__link > span:last-child {
    color: var(--color-muted);
  }

  @media (max-width: 44rem) {
    .related-tools__list {
      grid-template-columns: 1fr;
    }
  }
</style>
