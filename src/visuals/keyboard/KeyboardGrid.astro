---
type KeyWidth = 'normal' | 'wide' | 'wider' | 'widest' | 'space';

interface VisualKey {
  code: string;
  label: string;
  width?: KeyWidth;
}

const rows: readonly (readonly VisualKey[])[] = [
  [
    { code: 'Escape', label: 'Esc', width: 'wide' },
    { code: 'Digit1', label: '1' },
    { code: 'Digit2', label: '2' },
    { code: 'Digit3', label: '3' },
    { code: 'Digit4', label: '4' },
    { code: 'Digit5', label: '5' },
    { code: 'Digit6', label: '6' },
    { code: 'Digit7', label: '7' },
    { code: 'Digit8', label: '8' },
    { code: 'Digit9', label: '9' },
    { code: 'Digit0', label: '0' },
    { code: 'Minus', label: '-' },
    { code: 'Equal', label: '=' },
    { code: 'Backspace', label: 'Backspace', width: 'wider' },
  ],
  [
    { code: 'Tab', label: 'Tab', width: 'wide' },
    { code: 'KeyQ', label: 'Q' },
    { code: 'KeyW', label: 'W' },
    { code: 'KeyE', label: 'E' },
    { code: 'KeyR', label: 'R' },
    { code: 'KeyT', label: 'T' },
    { code: 'KeyY', label: 'Y' },
    { code: 'KeyU', label: 'U' },
    { code: 'KeyI', label: 'I' },
    { code: 'KeyO', label: 'O' },
    { code: 'KeyP', label: 'P' },
    { code: 'BracketLeft', label: '[' },
    { code: 'BracketRight', label: ']' },
    { code: 'Backslash', label: '\\', width: 'wide' },
  ],
  [
    { code: 'CapsLock', label: 'Caps', width: 'wider' },
    { code: 'KeyA', label: 'A' },
    { code: 'KeyS', label: 'S' },
    { code: 'KeyD', label: 'D' },
    { code: 'KeyF', label: 'F' },
    { code: 'KeyG', label: 'G' },
    { code: 'KeyH', label: 'H' },
    { code: 'KeyJ', label: 'J' },
    { code: 'KeyK', label: 'K' },
    { code: 'KeyL', label: 'L' },
    { code: 'Semicolon', label: ';' },
    { code: 'Quote', label: "'" },
    { code: 'Enter', label: 'Enter', width: 'widest' },
  ],
  [
    { code: 'ShiftLeft', label: 'Shift', width: 'widest' },
    { code: 'KeyZ', label: 'Z' },
    { code: 'KeyX', label: 'X' },
    { code: 'KeyC', label: 'C' },
    { code: 'KeyV', label: 'V' },
    { code: 'KeyB', label: 'B' },
    { code: 'KeyN', label: 'N' },
    { code: 'KeyM', label: 'M' },
    { code: 'Comma', label: ',' },
    { code: 'Period', label: '.' },
    { code: 'Slash', label: '/' },
    { code: 'ShiftRight', label: 'Shift', width: 'widest' },
  ],
  [
    { code: 'ControlLeft', label: 'Ctrl', width: 'wide' },
    { code: 'MetaLeft', label: 'Meta', width: 'wide' },
    { code: 'AltLeft', label: 'Alt', width: 'wide' },
    { code: 'Space', label: 'Space', width: 'space' },
    { code: 'AltRight', label: 'Alt', width: 'wide' },
    { code: 'MetaRight', label: 'Meta', width: 'wide' },
    { code: 'ControlRight', label: 'Ctrl', width: 'wide' },
    { code: 'ArrowLeft', label: '←' },
    { code: 'ArrowUp', label: '↑' },
    { code: 'ArrowDown', label: '↓' },
    { code: 'ArrowRight', label: '→' },
  ],
];
---

<div class="keyboard-visual" data-keyboard-grid aria-hidden="true">
  {rows.map((row) => (
    <div class="keyboard-row">
      {row.map((key) => (
        <span
          class:list={[
            'keyboard-key',
            key.width && `keyboard-key--${key.width}`,
          ]}
          data-key-code={key.code}
          data-pressed="false"
        >
          {key.label}
        </span>
      ))}
    </div>
  ))}
</div>

<style>
  .keyboard-visual {
    min-width: 43rem;
    display: grid;
    gap: 0.34rem;
    padding: var(--space-3);
    border: 1px solid #e3e6e7;
    border-radius: var(--radius-sm);
    background: #fafbfb;
  }

  .keyboard-row {
    display: flex;
    gap: 0.34rem;
  }

  .keyboard-key {
    min-width: 2.35rem;
    height: 2.35rem;
    flex: 1 1 0;
    display: grid;
    place-items: center;
    border: 1px solid #d5dadc;
    border-bottom-width: 2px;
    border-radius: 0.28rem;
    background: var(--color-surface);
    color: var(--color-muted);
    font: 0.72rem/1 var(--font-mono);
    transition:
      border-color 80ms ease,
      background-color 80ms ease,
      color 80ms ease,
      transform 80ms ease;
  }

  .keyboard-key--wide {
    flex-grow: 1.35;
  }

  .keyboard-key--wider {
    flex-grow: 1.7;
  }

  .keyboard-key--widest {
    flex-grow: 2.1;
  }

  .keyboard-key--space {
    flex-grow: 5.5;
  }

  .keyboard-key[data-pressed='true'] {
    border-color: var(--color-signal);
    background: color-mix(in srgb, var(--color-signal) 12%, var(--color-surface));
    color: var(--color-text);
    transform: translateY(1px);
  }
</style>
