---
import ToolShell from '../../../components/tool-shell/ToolShell.astro';
import { type ImplementedContentLocale } from '../../../i18n/content';
import { getRuntimeMessages } from '../../../i18n/runtime';
import StandardMouseVisual from '../../../visuals/mouse/StandardMouseVisual.astro';

interface Props { locale?: ImplementedContentLocale; }
const { locale = 'en' } = Astro.props;
const messages = getRuntimeMessages(locale).mouseButton;
---

<ToolShell labelledBy="mouse-button-heading">
  <h2 id="mouse-button-heading" class="sr-only">{messages.controlsHeading}</h2>
  <div class="button-test" data-mouse-button-test data-messages={JSON.stringify(messages)}>
    <div class="status"><span class="signal" aria-hidden="true"></span><strong data-mouse-button-status role="status" aria-live="polite">{messages.listening}</strong></div>
    <p class="instruction">{messages.instruction}</p>
    <div class="surface" data-mouse-button-surface>
      <div class="visual"><StandardMouseVisual /><p>{messages.semanticNote}</p></div>
      <div class="results">
        <div class="heading tool-result-heading"><span>{messages.resultHeading}</span><button type="button" class="mouse-reset tool-action tool-action--quiet" data-mouse-button-reset>{messages.reset}</button></div>
        {messages.buttonNames.map((name, button) => (
          <div class="row" data-mouse-button-row={button} data-held="false"><span>{name}</span><small data-button-detected>{messages.notDetected}</small><strong data-button-count>0</strong></div>
        ))}
      </div>
    </div>
    <p class="note">{messages.note}</p>
    <p class="sr-only" data-mouse-button-summary>{messages.initialSummary}</p>
  </div>
</ToolShell>

<script>
  import { readSerializedMessages, type ToolRuntimeMessages } from '../../../i18n/runtime';
  import { mountMouseButtonTest } from './mouse-button-controller';
  const root = document.querySelector<HTMLElement>('[data-mouse-button-test]');
  if (root) {
    const messages = readSerializedMessages<ToolRuntimeMessages<'mouseButton'>>(root);
    const controller = mountMouseButtonTest(root, messages);
    window.addEventListener('pagehide', (event) => event.persisted ? controller.stop() : controller.destroy());
    window.addEventListener('pageshow', (event) => { if (event.persisted) controller.start(); });
  }
</script>

<style>
  .button-test { display: grid; gap: var(--space-4); }
  .status { display: flex; align-items: center; gap: 0.55rem; color: var(--color-muted); font-size: 0.88rem; }
  .signal { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--color-signal); }
  .instruction, .note, .visual p { margin: 0; }
  .surface { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr); gap: var(--space-5); padding: var(--space-4); border: 1px solid #e3e6e7; background: #fafbfb; user-select: none; }
  .visual { display: grid; align-content: center; gap: var(--space-2); }
  .visual p, .note { color: var(--color-muted); font-size: 0.75rem; line-height: 1.45; text-align: center; }
  .results { display: grid; align-content: center; gap: 0.45rem; padding-left: var(--space-5); border-left: 1px solid #dfe3e4; }
  .row { display: grid; align-items: center; gap: var(--space-3); }
  .heading { margin-bottom: 0.35rem; color: var(--color-muted); font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.055em; }
  .row { grid-template-columns: minmax(0, 1fr) 7.5rem 2rem; min-height: 2.25rem; padding: 0.35rem 0.55rem; border: 1px solid #e2e5e6; background: #fff; }
  .row span { min-width: 0; font-size: 0.78rem; font-weight: 600; }
  .row small { color: var(--color-muted); }
  .row strong { color: #8c9295; font: 600 1rem var(--font-mono); text-align: right; }
  .row[data-held='true'] { border-color: color-mix(in srgb, var(--color-signal) 55%, #d8dcde); background: color-mix(in srgb, var(--color-signal) 8%, white); }
  .row[data-held='true'] strong { color: var(--color-signal); }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  @media (max-width: 48rem) { .surface { grid-template-columns: 1fr; } .results { padding: var(--space-4) 0 0; border-left: 0; border-top: 1px solid #dfe3e4; } }
  @media (max-width: 40rem) { .surface { padding: var(--space-3); } .row { grid-template-columns: 1fr auto; } .row small { grid-row: 2; } .row strong { grid-row: 1 / 3; grid-column: 2; } }
</style>
