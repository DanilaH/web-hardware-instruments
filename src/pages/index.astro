---
import ToolIcon from '../components/icons/ToolIcon.astro';
import { allTools, toolGroups } from '../config/tools';
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = toolGroups;
const columns = [[groups[0], groups[1]], [groups[2], groups[3], groups[4]]] as const;
---

<BaseLayout
  title="Hardware Inspect — Hardware Tests in Your Browser"
  description="Lightweight browser-based hardware diagnostics. No install or account required."
  canonicalPath="/"
  headerVariant="homepage"
>
  <section class="home-hero">
    <div class="home-hero__copy">
      <h1 class="page-heading">Hardware Tests in Your Browser</h1>
      <p class="page-intro">
        Focused diagnostics for controllers, mice, keyboards, displays, and touchscreens — built to show what the browser actually detects.
      </p>
      <p class="home-facts">{allTools.length} browser tests <span>·</span> no install <span>·</span> no account <span>·</span> input stays on this device</p>
    </div>

    <div class="instrument-screen" aria-label="Hardware input is observed through browser APIs on this device">
      <div class="instrument-screen__top">
        <strong>Browser boundary</strong>
        <span>Local observation</span>
      </div>
      <div class="instrument-screen__flow">
        <div class="instrument-screen__inputs" aria-hidden="true">
          <span data-channel="controller"><ToolIcon kind="gamepad" size={16} /><b>Controller</b></span>
          <span data-channel="mouse"><ToolIcon kind="mouse" size={16} /><b>Pointer</b></span>
          <span data-channel="keyboard"><ToolIcon kind="keyboard" size={16} /><b>Keyboard</b></span>
          <span data-channel="display"><ToolIcon kind="fps" size={16} /><b>Frames</b></span>
          <span data-channel="touch"><ToolIcon kind="touch" size={16} /><b>Touch</b></span>
        </div>
        <div class="instrument-screen__api" aria-hidden="true">
          <strong>Native browser APIs</strong>
          <span>signals cross this boundary</span>
        </div>
        <div class="instrument-screen__result" aria-hidden="true">
          <strong>Observed on this device</strong>
          <span>No input upload</span>
        </div>
      </div>
    </div>
  </section>

  <nav class="category-rail" aria-label="Hardware categories">
    {groups.map((group) => (
      <a href={`#${group.id}`} data-channel={group.channel}>
        <span class="category-rail__icon"><ToolIcon kind={group.icon} size={18} /></span>
        <span>{group.name}</span>
        <small>{group.tools.length}</small>
      </a>
    ))}
  </nav>

  <section class="home-tools" aria-labelledby="available-tools">
    <div class="home-tools__header">
      <h2 id="available-tools">Choose a tool</h2>
      <p>Each page does one job and explains what the browser can — and cannot — observe.</p>
    </div>

    <div class="tool-columns">
      {columns.map((column) => (
        <div class="tool-column">
          {column.map((group) => (
            <section class="tool-group" id={group.id} data-channel={group.channel} aria-labelledby={`tool-group-${group.id}`}>
              <header class="tool-group__header">
                <span class="tool-group__signal" aria-hidden="true"></span>
                <span class="tool-group__icon" aria-hidden="true"><ToolIcon kind={group.icon} size={20} /></span>
                <div>
                  <h3 id={`tool-group-${group.id}`}>{group.name}</h3>
                  <p>{group.tools.length} {group.tools.length === 1 ? 'tool' : 'tools'}</p>
                </div>
              </header>

              <div class="tool-list">
                {group.tools.map((tool) => (
                  <a class="tool-link" href={tool.href}>
                    <span class="tool-link__icon" aria-hidden="true"><ToolIcon kind={tool.icon} size={20} /></span>
                    <span class="tool-link__copy">
                      <strong>{tool.name}</strong>
                      <small>{tool.description}</small>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: 14.2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.62fr);
    align-items: center;
    gap: clamp(1.75rem, 4vw, 4.2rem);
    padding: clamp(1.7rem, 3.4vw, 2.65rem) clamp(1.5rem, 4vw, 3rem);
    border: 1px solid #c9cbc5;
    border-radius: 5px 5px 0 0;
    background: #ece9e1;
    color: #202725;
  }

  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: #384744;
  }

  .home-hero__copy {
    position: relative;
    z-index: 1;
    max-width: 43rem;
  }

  .home-hero .page-heading {
    max-width: 12ch;
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    line-height: 0.96;
  }

  .home-hero .page-intro {
    max-width: 42rem;
    margin-top: var(--space-4);
    font-size: 1rem;
  }

  .home-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: var(--space-4) 0 0;
    color: #59615e;
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.012em;
  }

  .home-facts span {
    color: #989d97;
  }

  .instrument-screen {
    align-self: stretch;
    min-height: 10.5rem;
    display: flex;
    flex-direction: column;
    border: 1px solid #bbbdb7;
    background: #f7f5ef;
  }

  .instrument-screen__top {
    min-height: 2.3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.55rem 0.72rem;
    border-bottom: 1px solid #d0d1cc;
    color: #4b5350;
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .instrument-screen__top strong {
    color: #26302d;
  }

  .instrument-screen__flow {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem;
  }

  .instrument-screen__inputs {
    display: grid;
    gap: 0.38rem;
  }

  .instrument-screen__inputs span {
    position: relative;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.44rem;
    padding: 0.42rem 0.48rem;
    border: 1px solid #d0d1cc;
    background: white;
    color: #404946;
    font-size: 0.7rem;
  }

  .instrument-screen__inputs span::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--channel);
  }

  .instrument-screen__inputs b {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .instrument-screen__api {
    width: 7.6rem;
    display: grid;
    gap: 0.25rem;
    padding: 0.7rem 0.6rem;
    border-block: 1px solid #9da39f;
    color: #44504c;
    text-align: center;
  }

  .instrument-screen__api strong,
  .instrument-screen__result strong {
    font-size: 0.72rem;
  }

  .instrument-screen__api span,
  .instrument-screen__result span {
    color: #717875;
    font-size: 0.65rem;
  }

  .instrument-screen__result {
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 0.68rem;
    border: 1px solid #aeb2ad;
    background: #e9ece8;
    color: #314039;
  }

  .category-rail {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid #c9cbc5;
    border-top: 0;
    background: #d3d5cf;
  }

  .category-rail a {
    position: relative;
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.45rem;
    min-height: 3.3rem;
    padding: 0.72rem 0.75rem;
    border-right: 1px solid #d3d5cf;
    background: #f4f2ec;
    color: #4b5350;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .category-rail a:last-child {
    border-right: 0;
  }

  .category-rail a::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 3px;
    background: var(--channel);
    scale: 0 1;
    transform-origin: left;
    transition: scale 130ms ease;
  }

  .category-rail a:hover,
  .category-rail a:focus-visible {
    color: #27312e;
    background: white;
  }

  .category-rail a:hover::after,
  .category-rail a:focus-visible::after {
    scale: 1 1;
  }

  .category-rail__icon {
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    color: #5f6965;
  }

  .category-rail small {
    color: #8b918e;
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .home-tools {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .home-tools__header {
    max-width: 46rem;
    margin-bottom: var(--space-5);
  }

  .home-tools__header h2 {
    margin: 0;
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    letter-spacing: -0.035em;
  }

  .home-tools__header p {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
  }

  .tool-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    align-items: start;
  }

  .tool-column {
    display: grid;
    gap: var(--space-4);
  }

  .tool-group {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .tool-group__header {
    display: flex;
    align-items: center;
    gap: 0.72rem;
    min-height: 3.85rem;
    padding: 0.72rem 0.78rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-strong);
  }

  .tool-group__signal {
    width: 0.22rem;
    height: 1.9rem;
    flex: none;
    background: var(--channel);
  }

  .tool-group__icon {
    width: 1.8rem;
    height: 1.8rem;
    flex: none;
    display: grid;
    place-items: center;
    color: #606966;
  }

  .tool-group__header h3,
  .tool-group__header p {
    margin: 0;
  }

  .tool-group__header h3 {
    color: var(--color-text);
    font-size: 0.96rem;
    letter-spacing: -0.015em;
  }

  .tool-group__header p {
    margin-top: 0.08rem;
    color: var(--color-muted);
    font-size: 0.7rem;
  }

  .tool-list {
    display: grid;
  }

  .tool-link {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.72rem;
    padding: 0.75rem 0.78rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition: background 120ms ease;
  }

  .tool-link:last-child {
    border-bottom: 0;
  }

  .tool-link::after {
    content: '→';
    color: #8c928e;
    font-size: 0.9rem;
    transition: translate 120ms ease, color 120ms ease;
  }

  .tool-link:hover,
  .tool-link:focus-visible {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-surface-strong) 60%, var(--color-surface));
  }

  .tool-link:hover::after,
  .tool-link:focus-visible::after {
    color: var(--channel);
    translate: 2px 0;
  }

  .tool-link__icon {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--channel) 36%, var(--color-border));
    background: color-mix(in srgb, var(--channel) 8%, var(--color-surface));
    color: var(--channel);
  }

  .tool-link__copy {
    min-width: 0;
  }

  .tool-link__copy strong,
  .tool-link__copy small {
    display: block;
  }

  .tool-link__copy strong {
    font-size: 0.85rem;
    line-height: 1.2;
  }

  .tool-link__copy small {
    margin-top: 0.12rem;
    color: var(--color-muted);
    font-size: 0.74rem;
    line-height: 1.35;
  }

  @media (prefers-reduced-motion: reduce) {
    .category-rail a::after,
    .tool-link,
    .tool-link::after {
      transition: none;
    }
  }

  @media (max-width: 56rem) {
    .home-hero {
      grid-template-columns: 1fr;
    }

    .instrument-screen {
      min-height: 8.8rem;
    }

    .tool-columns {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .home-hero {
      padding: 1.4rem 1.2rem;
    }

    .home-hero .page-heading {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .instrument-screen__flow {
      grid-template-columns: 1fr;
      align-items: stretch;
    }

    .instrument-screen__inputs {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .instrument-screen__inputs span {
      justify-content: center;
    }

    .instrument-screen__inputs b {
      display: none;
    }

    .instrument-screen__api {
      width: auto;
      border: 1px solid #b4b8b3;
    }

    .category-rail {
      display: flex;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline mandatory;
      scrollbar-width: none;
    }

    .category-rail::-webkit-scrollbar {
      display: none;
    }

    .category-rail a {
      min-width: 8rem;
      scroll-snap-align: start;
    }

    .tool-columns {
      gap: var(--space-3);
    }
  }
</style>
