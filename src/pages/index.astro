---
import ToolIcon from '../components/icons/ToolIcon.astro';
import { toolGroups } from '../config/tools';
import { getSiteContent, type ImplementedContentLocale } from '../i18n/content';
import { getHomeSignalLabel } from '../i18n/home-signals';
import { buildLocalizedPath } from '../i18n/routing';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale?: ImplementedContentLocale;
}

const { locale = 'en' } = Astro.props;
const siteContent = getSiteContent(locale);
const content = siteContent.home;
const groups = toolGroups.map((group) => ({
  ...group,
  name: siteContent.categories[group.id],
  signalLabel: getHomeSignalLabel(locale, group.id),
  tools: group.tools.map((tool) => ({
    ...tool,
    href: buildLocalizedPath(locale, tool.href),
    name: siteContent.tools[tool.id].name,
    description: siteContent.tools[tool.id].shortDescription,
  })),
}));
const splitIndex = Math.max(1, Math.floor(groups.length / 2));
const columns = [groups.slice(0, splitIndex), groups.slice(splitIndex)] as const;
const facts = content.facts.split(' · ');
---

<BaseLayout
  title={content.seoTitle}
  description={content.metaDescription}
  canonicalPath="/"
  locale={locale}
  headerVariant="homepage"
>
  <section class="home-hero">
    <div class="home-hero__copy">
      <h1 class="page-heading">{content.h1}</h1>
      <p class="page-intro">{content.intro}</p>
      <p class="home-facts">
        {facts.map((fact, index) => (
          <>{index > 0 && <span>·</span>}{fact}</>
        ))}
      </p>
    </div>

    <div class="instrument-screen" aria-label={content.boundaryAria}>
      <div class="instrument-screen__top">
        <strong>{content.boundaryTitle}</strong>
        <span>{content.boundaryLocal}</span>
      </div>
      <div class="instrument-screen__flow">
        <div class="instrument-screen__inputs" aria-hidden="true">
          {groups.map((group, index) => (
            <span data-channel={group.id} style={`--flow-delay: ${index * 0.35}s`}>
              <ToolIcon kind={group.signalIcon} size={16} />
              <b>{group.signalLabel}</b>
            </span>
          ))}
        </div>
        <div class="instrument-screen__api" aria-hidden="true">
          <strong>{content.boundarySignals}</strong>
        </div>
        <div class="instrument-screen__result" aria-hidden="true">
          <strong>{content.boundaryObserved}</strong>
          <span>{content.boundaryNoUpload}</span>
        </div>
      </div>
    </div>
  </section>

  <nav
    class="category-rail"
    aria-label={content.categoryAria}
    style={`--category-count: ${groups.length}`}
  >
    {groups.map((group) => (
      <a href={`#${group.id}`} data-channel={group.id}>
        <span class="category-rail__icon"><ToolIcon kind={group.icon} size={18} /></span>
        <span>{group.name}</span>
        <small>{group.tools.length}</small>
      </a>
    ))}
  </nav>

  <section class="home-tools" aria-labelledby="available-tools">
    <div class="home-tools__header">
      <h2 id="available-tools">{content.chooseTool}</h2>
      <p>{content.chooseToolIntro}</p>
    </div>

    <div class="tool-columns">
      {columns.map((column) => (
        <div class="tool-column">
          {column.map((group) => (
            <section class="tool-group" id={group.id} data-channel={group.id} aria-labelledby={`tool-group-${group.id}`}>
              <header class="tool-group__header">
                <span class="tool-group__signal" aria-hidden="true"></span>
                <span class="tool-group__icon" aria-hidden="true"><ToolIcon kind={group.icon} size={20} /></span>
                <div>
                  <h3 id={`tool-group-${group.id}`}>{group.name}</h3>
                  <p>{group.tools.length} {group.tools.length === 1 ? content.toolCountSingle : content.toolCountPlural}</p>
                </div>
              </header>

              <div class="tool-list">
                {group.tools.map((tool) => (
                  <a class="tool-link" href={tool.href}>
                    <span class="tool-link__icon" aria-hidden="true"><ToolIcon kind={tool.icon} size={20} /></span>
                    <span class="tool-link__copy">
                      <strong>{tool.name}</strong>
                      <small>{tool.description}</small>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: 14.2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.62fr);
    align-items: center;
    gap: clamp(1.75rem, 4vw, 4.2rem);
    padding: clamp(1.7rem, 3.4vw, 2.65rem) clamp(1.5rem, 4vw, 3rem);
    border: 1px solid #c9cbc5;
    border-radius: 5px 5px 0 0;
    background: #ece9e1;
    color: #202725;
  }

  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: #384744;
  }

  .home-hero__copy {
    max-width: 47rem;
  }

  .home-hero .page-heading {
    max-width: 43rem;
    margin-bottom: var(--space-3);
    color: #1e2624;
    font-size: clamp(2.45rem, 5vw, 4.2rem);
    line-height: 0.96;
    letter-spacing: -0.052em;
  }

  .home-hero .page-intro {
    max-width: 42rem;
    color: #5f6966;
    font-size: clamp(0.99rem, 1.5vw, 1.08rem);
    line-height: 1.52;
  }

  .home-facts {
    margin: var(--space-4) 0 0;
    color: #69716e;
    font-size: 0.76rem;
    font-weight: 620;
    line-height: 1.45;
  }

  .home-facts span {
    margin-inline: 0.38rem;
    color: #a0a49f;
  }

  .instrument-screen {
    min-width: 0;
    border: 1px solid #303735;
    background: #171d1c;
    color: #dde1dc;
  }

  .instrument-screen__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid #313836;
  }

  .instrument-screen__top strong,
  .instrument-screen__top span {
    font-size: 0.62rem;
    line-height: 1.2;
  }

  .instrument-screen__top strong {
    color: #d9ded8;
  }

  .instrument-screen__top span {
    color: #747f7b;
  }

  .instrument-screen__flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(7rem, 0.86fr) minmax(7.2rem, 0.9fr);
    min-height: 10.5rem;
  }

  .instrument-screen__inputs {
    display: grid;
    align-content: center;
    border-right: 1px solid #313836;
  }

  .instrument-screen__inputs span {
    position: relative;
    display: grid;
    grid-template-columns: 1.35rem minmax(0, 1fr);
    align-items: center;
    gap: 0.38rem;
    min-width: 0;
    padding: 0.33rem 0.62rem 0.33rem 0.72rem;
    color: #abb2ae;
  }

  .instrument-screen__inputs span + span {
    border-top: 1px solid #282e2c;
  }

  .instrument-screen__inputs span::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    width: 1.8rem;
    height: 1px;
    translate: 0 -50%;
    background: var(--channel);
    opacity: 0.75;
  }

  .instrument-screen__inputs svg {
    color: var(--channel);
  }

  .instrument-screen__inputs b {
    overflow: hidden;
    color: #b9c0bc;
    font-size: 0.61rem;
    font-weight: 620;
    text-overflow: ellipsis;
  }

  .instrument-screen__api,
  .instrument-screen__result {
    position: relative;
    display: grid;
    place-content: center;
    gap: 0.22rem;
    padding: 0.8rem;
    text-align: center;
  }

  .instrument-screen__api {
    border-right: 1px solid #313836;
    background:
      linear-gradient(rgba(229, 234, 227, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(229, 234, 227, 0.04) 1px, transparent 1px);
    background-size: 14px 14px;
  }

  .instrument-screen__api::before,
  .instrument-screen__result::before {
    content: '';
    position: absolute;
    left: -0.34rem;
    top: 50%;
    width: 0.68rem;
    height: 0.68rem;
    translate: 0 -50%;
    border: 1px solid #66716d;
    background: #171d1c;
  }

  .instrument-screen__api strong,
  .instrument-screen__result strong {
    color: #d8ddd7;
    font-size: 0.69rem;
    line-height: 1.2;
  }

  .instrument-screen__api span,
  .instrument-screen__result span {
    color: #747f7b;
    font-size: 0.55rem;
    line-height: 1.3;
  }

  .instrument-screen__result strong {
    color: #ced8d2;
  }

  .category-rail {
    display: grid;
    grid-template-columns: repeat(var(--category-count), minmax(0, 1fr));
    margin-top: -1px;
    border: 1px solid #c9cbc5;
    border-top: 0;
    border-radius: 0 0 5px 5px;
    background: #f3f1eb;
  }

  .category-rail a {
    position: relative;
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.58rem;
    padding: 0.7rem 0.78rem;
    border-right: 1px solid #d3d5cf;
    color: #313936;
    text-decoration: none;
    transition: background 120ms ease, color 120ms ease;
  }

  .category-rail a::after {
    content: '';
    position: absolute;
    right: 0.7rem;
    bottom: -1px;
    left: 0.7rem;
    height: 2px;
    background: var(--channel);
    scale: 0 1;
    transform-origin: left;
    transition: scale 150ms ease;
  }

  .category-rail a:last-child {
    border-right: 0;
  }

  .category-rail a:hover {
    color: #1f2724;
    background: #ebe9e2;
  }

  .category-rail a:hover::after {
    scale: 1 1;
  }

  .category-rail__icon {
    display: grid;
    place-items: center;
    color: #626b68;
    transition: color 120ms ease;
  }

  .category-rail a:hover .category-rail__icon {
    color: var(--channel);
  }

  .category-rail a > span:nth-child(2) {
    overflow: hidden;
    font-size: 0.79rem;
    font-weight: 700;
    text-overflow: ellipsis;
  }

  .category-rail small {
    color: #969b96;
    font: 600 0.6rem var(--font-mono);
  }

  .home-tools {
    margin-top: var(--space-6);
  }

  .home-tools__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid #cfd3d1;
  }

  .home-tools__header h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2.5vw, 1.95rem);
    letter-spacing: -0.035em;
  }

  .home-tools__header > p {
    max-width: 31rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .tool-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-5);
  }

  .tool-column {
    min-width: 0;
    display: grid;
    gap: var(--space-5);
  }

  .tool-group {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #cfd3d1;
    border-radius: 5px;
    background: #faf9f5;
    scroll-margin-top: 1rem;
  }

  .tool-group__header {
    display: grid;
    grid-template-columns: 0.22rem auto minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    padding: 0.72rem 0.82rem;
    border-bottom: 1px solid #d8dbd8;
    background: #f0ede6;
  }

  .tool-group__signal {
    width: 0.2rem;
    height: 1.75rem;
    background: var(--channel);
  }

  .tool-group__icon {
    display: grid;
    place-items: center;
    color: #59625f;
  }

  .tool-group h3 {
    margin: 0;
    font-size: 0.91rem;
    letter-spacing: -0.01em;
  }

  .tool-group__header p {
    margin: 0.04rem 0 0;
    color: #8b918e;
    font-size: 0.64rem;
    font-weight: 600;
  }

  .tool-list {
    display: grid;
  }

  .tool-link {
    position: relative;
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.72rem;
    padding: 0.77rem 0.82rem 0.79rem;
    text-decoration: none;
    transition: background 110ms ease;
  }

  .tool-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--channel);
    scale: 0 1;
    transform-origin: left;
    transition: scale 165ms ease;
  }

  .tool-link + .tool-link {
    border-top: 1px solid #e1e3e0;
  }

  .tool-link:hover {
    color: #171a1b;
    background: #f3f1eb;
  }

  .tool-link:hover::after,
  .tool-link:focus-visible::after {
    scale: 1 1;
  }

  .tool-link__icon {
    display: grid;
    place-items: center;
    color: #56605d;
    transition: color 120ms ease, translate 120ms ease;
  }

  .tool-link:hover .tool-link__icon,
  .tool-link:focus-visible .tool-link__icon {
    color: var(--channel);
    translate: 2px 0;
  }

  .tool-link__copy {
    min-width: 0;
  }

  .tool-link strong,
  .tool-link small {
    display: block;
  }

  .tool-link strong {
    color: #242a29;
    font-size: 0.89rem;
    line-height: 1.25;
  }

  .tool-link small {
    margin-top: 0.1rem;
    color: #717875;
    font-size: 0.74rem;
    line-height: 1.35;
  }

  @media (prefers-reduced-motion: no-preference) {
    .instrument-screen__inputs span::after {
      animation: channel-flow 4.5s ease-in-out infinite;
      animation-delay: var(--flow-delay, 0s);
    }
  }

  @keyframes channel-flow {
    0%, 72%, 100% { opacity: 0.28; scale: 0.45 1; transform-origin: right; }
    12%, 28% { opacity: 0.9; scale: 1 1; transform-origin: right; }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-rail a,
    .category-rail a::after,
    .category-rail__icon,
    .tool-link,
    .tool-link::after,
    .tool-link__icon {
      transition: none;
    }
  }

  @media (max-width: 52rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: var(--space-4);
    }

    .instrument-screen__flow {
      grid-template-columns: 1fr 0.92fr;
    }

    .instrument-screen__result {
      grid-column: 1 / -1;
      border-top: 1px solid #313836;
    }

    .instrument-screen__api {
      border-right: 0;
    }

    .instrument-screen__result::before {
      left: 50%;
      top: -0.35rem;
    }

    .category-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .category-rail a:nth-child(3n) {
      border-right: 0;
    }

    .category-rail a:nth-child(n + 4) {
      border-top: 1px solid #d3d5cf;
    }

    .tool-columns {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .home-hero {
      display: block;
      min-height: auto;
      padding: var(--space-5) var(--space-5) 1.35rem;
      border-radius: 4px 4px 0 0;
    }

    .home-hero .page-heading {
      max-width: 19rem;
      font-size: clamp(2.15rem, 11.5vw, 3rem);
    }

    .home-hero .page-intro {
      max-width: 20rem;
      font-size: 0.92rem;
    }

    .home-facts {
      margin-top: var(--space-3);
      font-size: 0.67rem;
    }

    .home-facts span {
      margin-inline: 0.25rem;
    }

    .instrument-screen {
      display: none;
    }

    .category-rail {
      display: flex;
      margin-top: -1px;
      overflow-x: auto;
      border-radius: 0 0 4px 4px;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }

    .category-rail::-webkit-scrollbar {
      display: none;
    }

    .category-rail a {
      flex: 0 0 8.9rem;
      scroll-snap-align: start;
      padding: 0.65rem 0.68rem;
      border-top: 0 !important;
      border-right: 1px solid #d3d5cf !important;
    }

    .category-rail a:last-child {
      border-right: 0 !important;
    }

    .home-tools {
      margin-top: var(--space-5);
    }

    .home-tools__header {
      display: block;
    }

    .home-tools__header > p {
      margin-top: 0.5rem;
    }

    .tool-column,
    .tool-columns {
      gap: var(--space-4);
    }

    .tool-group {
      border-radius: 4px;
    }

    .tool-link {
      gap: 0.58rem;
      padding: 0.72rem 0.66rem 0.74rem;
    }
  }
</style>
