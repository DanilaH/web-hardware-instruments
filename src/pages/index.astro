---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Hardware Tests in Your Browser"
  description="Lightweight browser-based hardware diagnostics. No install or account required."
  canonicalPath="/"
  noindex={true}
>
  <section class="reading-width">
    <h1 class="page-heading">Hardware Tests in Your Browser</h1>
    <p class="page-intro">Small, focused diagnostics that run directly in your browser.</p>

    <p class="foundation-note">
      <strong>Foundation build.</strong> Tool pages are intentionally not published in Phase 0. This homepage stays noindex until the first working diagnostic release.
    </p>
  </section>
</BaseLayout>
