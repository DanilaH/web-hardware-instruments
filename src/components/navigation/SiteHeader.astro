---
import BrandMark from '../icons/BrandMark.astro';
import { siteConfig } from '../../config/site';

interface Props {
  variant?: 'default' | 'homepage';
}

const { variant = 'default' } = Astro.props;
---

<header class="site-header" data-variant={variant}>
  <div class="site-header__inner shell-width">
    <a class="site-header__brand" href="/">
      {variant === 'homepage' && (
        <span class="site-header__mark" aria-hidden="true"><BrandMark size={30} /></span>
      )}
      <span class="site-header__brand-copy">
        <strong>{siteConfig.name}</strong>
        {variant === 'homepage' && <small>Browser diagnostics</small>}
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Primary navigation">
      {variant === 'homepage' && <span class="site-header__catalog-count"><b>18</b><span>/ tools</span></span>}
      <a href="/" aria-current={variant === 'homepage' ? 'page' : undefined}>Tools</a>
      <a href="/about">About</a>
    </nav>
  </div>
</header>

<style>
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .site-header__brand-copy {
    display: grid;
  }

  .site-header__brand-copy strong {
    font: inherit;
  }

  .site-header__brand-copy small,
  .site-header__catalog-count {
    display: none;
  }

  .site-header[data-variant='homepage'] {
    border-bottom: 1px solid #34393a;
    background: #171a1b;
    color: #f1eee7;
  }

  .site-header[data-variant='homepage'] .site-header__inner {
    min-height: 4rem;
  }

  .site-header[data-variant='homepage'] .site-header__brand {
    color: #f4f0e8;
  }

  .site-header[data-variant='homepage'] .site-header__mark {
    width: 2.1rem;
    height: 2.1rem;
    display: grid;
    place-items: center;
    padding-right: 0.65rem;
    border-right: 1px solid #3a3f40;
    color: #ff6b35;
  }

  .site-header[data-variant='homepage'] .site-header__brand-copy strong {
    font-size: 0.94rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .site-header[data-variant='homepage'] .site-header__brand-copy small {
    display: block;
    margin-top: 0.18rem;
    color: #8e9797;
    font: 600 0.58rem/1.1 var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .site-header[data-variant='homepage'] .site-header__nav {
    align-items: center;
    gap: 1rem;
  }

  .site-header[data-variant='homepage'] .site-header__nav a {
    position: relative;
    padding: 0.42rem 0.05rem;
    color: #abb1b0;
    font-size: 0.79rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    transition: color 120ms ease;
  }

  .site-header[data-variant='homepage'] .site-header__nav a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: #ff6b35;
    scale: 0 1;
    transform-origin: left;
    transition: scale 120ms ease;
  }

  .site-header[data-variant='homepage'] .site-header__nav a:hover,
  .site-header[data-variant='homepage'] .site-header__nav a[aria-current='page'] {
    color: #f4f0e8;
  }

  .site-header[data-variant='homepage'] .site-header__nav a:hover::after,
  .site-header[data-variant='homepage'] .site-header__nav a[aria-current='page']::after {
    scale: 1 1;
  }

  .site-header[data-variant='homepage'] .site-header__catalog-count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28rem;
    margin-right: 0.2rem;
    padding-right: 1rem;
    border-right: 1px solid #3a3f40;
    color: #777f7f;
    font: 600 0.59rem var(--font-mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .site-header[data-variant='homepage'] .site-header__catalog-count b {
    color: #ff6b35;
    font-size: 0.74rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header[data-variant='homepage'] .site-header__nav a,
    .site-header[data-variant='homepage'] .site-header__nav a::after {
      transition: none;
    }
  }

  @media (max-width: 40rem) {
    .site-header[data-variant='homepage'] .site-header__inner {
      min-height: 3.7rem;
    }

    .site-header[data-variant='homepage'] .site-header__mark {
      width: 1.85rem;
      height: 1.85rem;
      padding-right: 0.5rem;
    }

    .site-header[data-variant='homepage'] .site-header__brand-copy small,
    .site-header[data-variant='homepage'] .site-header__catalog-count {
      display: none;
    }

    .site-header[data-variant='homepage'] .site-header__nav {
      gap: 0.75rem;
    }
  }
</style>
