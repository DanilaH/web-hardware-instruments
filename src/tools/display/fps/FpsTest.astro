---
import ToolShell from '../../../components/tool-shell/ToolShell.astro';
---

<ToolShell labelledBy="fps-tool-heading">
  <h2 id="fps-tool-heading" class="display-tool__sr">FPS Test measurement</h2>

  <div class="display-tool display-tool--fps" data-fps-test data-state="warming">
    <div class="display-tool__status-row">
      <span class="display-tool__signal" aria-hidden="true"></span>
      <strong data-display-status role="status" aria-live="polite" aria-atomic="true">Warming up</strong>
      <span class="display-tool__status-note">Measures automatically while this page is visible.</span>
    </div>

    <div class="fps-layout">
      <div class="fps-trace-panel">
        <div class="trace-label" aria-hidden="true">
          <span>Recent FPS</span>
          <span>8 s history</span>
        </div>
        <canvas
          class="display-trace display-trace--fps"
          data-fps-trace
          aria-hidden="true"
        ></canvas>
      </div>

      <div class="fps-result-panel">
        <div>
          <div class="metric-label">Observed FPS</div>
          <div class="metric-value measurement-value" data-fps-result>—</div>
        </div>

        <div class="supporting-metric">
          <span>Median frame time</span>
          <strong class="measurement-value" data-frame-time>—</strong>
        </div>

        <p class="measurement-caveat">
          This measures frame delivery in this browser page, not FPS inside a game.
        </p>
      </div>
    </div>

    <p class="display-tool__sr" data-display-accessible-summary>
      FPS measurement is warming up.
    </p>
  </div>
</ToolShell>

<script>
  import { mountFpsTest } from './fps-test-controller';

  const root = document.querySelector<HTMLElement>('[data-fps-test]');
  if (root) {
    const controller = mountFpsTest(root);

    window.addEventListener('pagehide', (event) => {
      if (event.persisted) {
        controller.stop();
        return;
      }
      controller.destroy();
    });

    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        controller.start();
      }
    });
  }
</script>

<style>
  .display-tool {
    --trace-grid: #e2e6e7;
    --trace-signal: var(--color-signal);
    --trace-neutral: #899296;
    display: grid;
    gap: var(--space-4);
  }

  .display-tool__status-row {
    min-height: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .display-tool__status-row strong {
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .display-tool__signal {
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 auto;
    border: 1px solid #aeb4b7;
    border-radius: 50%;
    background: #dfe2e3;
  }

  .display-tool[data-state='live'] .display-tool__signal {
    border-color: var(--color-signal);
    background: var(--color-signal);
  }

  .display-tool[data-state='unavailable'] .display-tool__signal {
    border-color: #8c5555;
    background: #b36a6a;
  }

  .display-tool__status-note {
    margin-left: auto;
  }

  .fps-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(15rem, 0.75fr);
    min-height: 15rem;
    border-block: 1px solid #e3e6e7;
  }

  .fps-trace-panel {
    min-width: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: var(--space-3) var(--space-4) var(--space-4) 0;
    border-right: 1px solid #e3e6e7;
    background-image:
      linear-gradient(#f0f2f2 1px, transparent 1px),
      linear-gradient(90deg, #f0f2f2 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .trace-label {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-left: var(--space-3);
    color: var(--color-muted);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .display-trace {
    width: 100%;
    height: 12rem;
    display: block;
  }

  .fps-result-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-4) 0 var(--space-4) var(--space-5);
  }

  .metric-label,
  .supporting-metric span {
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .metric-value {
    margin-top: 0.15rem;
    font-size: clamp(3.4rem, 6vw, 5.2rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .supporting-metric {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid #e5e8e9;
  }

  .supporting-metric strong {
    font-size: 1rem;
  }

  .measurement-caveat {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .display-tool__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 44rem) {
    .display-tool__status-row {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .display-tool__status-note {
      width: 100%;
      margin-left: 1.1rem;
    }

    .fps-layout {
      grid-template-columns: 1fr;
    }

    .fps-trace-panel {
      padding-right: 0;
      border-right: 0;
      border-bottom: 1px solid #e3e6e7;
    }

    .display-trace {
      height: 9.5rem;
    }

    .fps-result-panel {
      padding: var(--space-4) 0 0;
    }

    .metric-value {
      font-size: 3.5rem;
    }
  }
</style>
