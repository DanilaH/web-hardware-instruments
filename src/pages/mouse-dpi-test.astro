---
import RelatedTools from '../components/navigation/RelatedTools.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import MouseDpiTest from '../tools/mouse/dpi/MouseDpiTest.astro';

const relatedTools = [
  {
    href: '/gamepad-tester',
    name: 'Gamepad Tester',
    description: 'Test controller buttons, sticks, D-pad, and triggers.',
  },
  {
    href: '/fps-test',
    name: 'FPS Test',
    description: 'Observe this browser page’s frame delivery and recent drops.',
  },
] as const;
---

<BaseLayout
  title="Mouse DPI Test — Estimate Your Mouse DPI"
  description="Estimate mouse DPI in your browser by moving your mouse a measured physical distance. No install or account required."
  canonicalPath="/mouse-dpi-test"
>
  <section class="reading-width">
    <h1 class="page-heading">Mouse DPI Test</h1>
    <p class="page-intro">
      Estimate mouse DPI by moving your mouse a measured physical distance.
    </p>
  </section>

  <MouseDpiTest />

  <section class="tool-content reading-width" aria-labelledby="mouse-dpi-how-to">
    <h2 id="mouse-dpi-how-to">How to test mouse DPI</h2>
    <ol>
      <li>Measure a horizontal distance on your desk or mouse pad.</li>
      <li>Enter that distance and start the test.</li>
      <li>Move the mouse horizontally by exactly that physical distance.</li>
      <li>Click once to finish and read the Estimated DPI result.</li>
    </ol>

    <h2>What the result means</h2>
    <p>
      The browser reports relative movement units, while you provide the physical travel distance. The test divides the absolute net horizontal movement by that distance in inches to estimate DPI.
    </p>

    <h2>Accuracy and browser limitations</h2>
    <p>
      Raw Pointer Lock is preferred when available. Regular Pointer Lock or unlocked browser movement can be affected by OS acceleration, browser or OS movement units, zoom or scaling, screen edges, and event processing. The result is therefore always an estimate rather than a direct hardware DPI reading.
    </p>
  </section>

  <RelatedTools tools={relatedTools} />
</BaseLayout>

<style>
  .tool-content {
    margin-top: var(--space-7);
    padding-bottom: var(--space-7);
  }

  .tool-content h2 {
    margin: var(--space-6) 0 var(--space-2);
    font-size: 1.15rem;
  }

  .tool-content p,
  .tool-content ol {
    color: var(--color-muted);
    line-height: 1.65;
  }

  .tool-content ol {
    padding-left: 1.25rem;
  }
</style>
