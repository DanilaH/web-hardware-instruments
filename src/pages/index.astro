---
import ToolIcon from '../components/icons/ToolIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const controllerTools = [
  {
    href: '/gamepad-tester',
    icon: 'gamepad',
    name: 'Gamepad Tester',
    description: 'Test controller buttons, sticks, D-pad, and triggers.',
  },
  {
    href: '/controller-stick-drift-test',
    icon: 'drift',
    name: 'Controller Stick Drift Test',
    description: 'Measure observed analog-stick center offset while untouched.',
  },
  {
    href: '/controller-deadzone-test',
    icon: 'deadzone',
    name: 'Controller Deadzone Test',
    description: 'Measure stick center noise and a heuristic starting deadzone.',
  },
] as const;

const mouseTools = [
  {
    href: '/mouse-tester',
    icon: 'mouse',
    name: 'Mouse Tester',
    description: 'Check browser-detected mouse buttons, wheel input, and movement.',
  },
  {
    href: '/mouse-button-test',
    icon: 'button',
    name: 'Mouse Button Test',
    description: 'Check primary, middle, secondary, back, and forward button input.',
  },
  {
    href: '/mouse-scroll-test',
    icon: 'scroll',
    name: 'Mouse Scroll Test',
    description: 'Inspect browser-detected wheel directions and recent events.',
  },
  {
    href: '/double-click-test',
    icon: 'double-click',
    name: 'Double Click Test',
    description: 'Look for unusually fast repeated same-button presses.',
  },
  {
    href: '/mouse-polling-rate-test',
    icon: 'polling',
    name: 'Mouse Polling Rate Test',
    description: 'Measure the pointer sample rate observed by this browser.',
  },
  {
    href: '/mouse-dpi-test',
    icon: 'dpi',
    name: 'Mouse DPI Test',
    description: 'Estimate mouse DPI from a measured physical movement distance.',
  },
] as const;

const keyboardTools = [
  {
    href: '/keyboard-tester',
    icon: 'keyboard',
    name: 'Keyboard Tester',
    description: 'Press keys and see which physical key codes the browser detects.',
  },
  {
    href: '/keyboard-rollover-test',
    icon: 'rollover',
    name: 'Keyboard Rollover Test',
    description: 'See the largest simultaneous key set this browser detects.',
  },
  {
    href: '/keyboard-ghosting-test',
    icon: 'ghosting',
    name: 'Keyboard Ghosting Test',
    description: 'Compare guided key combinations with the keys detected together.',
  },
] as const;

const displayTools = [
  {
    href: '/fps-test',
    icon: 'fps',
    name: 'FPS Test',
    description: 'Observe this browser page’s frame delivery and recent drops.',
  },
  {
    href: '/refresh-rate-test',
    icon: 'refresh',
    name: 'Refresh Rate Test',
    description: 'Estimate the display cadence currently visible to the browser.',
  },
  {
    href: '/frame-skipping-test',
    icon: 'frame-skip',
    name: 'Frame Skipping Test',
    description: 'Use a camera-assisted pattern to look for repeatable skipped-refresh gaps.',
  },
  {
    href: '/dead-pixel-test',
    icon: 'dead-pixel',
    name: 'Dead Pixel Test',
    description: 'Inspect the screen against solid colors for dead or stuck pixels.',
  },
  {
    href: '/backlight-bleed-test',
    icon: 'backlight',
    name: 'Backlight Bleed Test',
    description: 'Inspect a backlit display for bright leakage on a black screen.',
  },
] as const;

const touchTools = [
  {
    href: '/touch-screen-test',
    icon: 'touch',
    name: 'Touch Screen Test',
    description: 'Map browser-detected finger coverage, multi-touch, and unexpected touch input.',
  },
] as const;

const groups = [
  { id: 'controller', name: 'Controller', icon: 'gamepad', tone: 'blue', tools: controllerTools },
  { id: 'mouse', name: 'Mouse', icon: 'mouse', tone: 'cyan', tools: mouseTools },
  { id: 'keyboard', name: 'Keyboard', icon: 'keyboard', tone: 'violet', tools: keyboardTools },
  { id: 'display', name: 'Display', icon: 'refresh', tone: 'sky', tools: displayTools },
  { id: 'touch', name: 'Touch', icon: 'touch', tone: 'teal', tools: touchTools },
] as const;

const columns = [[groups[0], groups[1]], [groups[2], groups[3], groups[4]]] as const;
---

<BaseLayout
  title="Hardware Tests in Your Browser"
  description="Lightweight browser-based hardware diagnostics. No install or account required."
  canonicalPath="/"
  headerVariant="homepage"
>
  <section class="home-hero">
    <div class="home-hero__copy">
      <p class="home-eyebrow"><span aria-hidden="true"></span> Browser diagnostics · local by default</p>
      <h1 class="page-heading">Hardware Tests in Your Browser</h1>
      <p class="page-intro">
        Focused diagnostics for controllers, mice, keyboards, displays, and touchscreens — built to show what the browser actually detects.
      </p>

      <div class="home-facts" aria-label="Site facts">
        <span><strong>18</strong><small>focused tools</small></span>
        <span><strong>0</strong><small>installs</small></span>
        <span><strong>Local</strong><small>raw input</small></span>
      </div>
    </div>

    <div class="diagnostic-visual" aria-hidden="true">
      <div class="diagnostic-grid"></div>
      <span class="diagnostic-ring diagnostic-ring--outer"></span>
      <span class="diagnostic-ring diagnostic-ring--inner"></span>
      <span class="diagnostic-axis diagnostic-axis--x"></span>
      <span class="diagnostic-axis diagnostic-axis--y"></span>
      <span class="diagnostic-core"></span>

      <span class="diagnostic-node diagnostic-node--gamepad"><ToolIcon kind="gamepad" size={18} /></span>
      <span class="diagnostic-node diagnostic-node--mouse"><ToolIcon kind="mouse" size={18} /></span>
      <span class="diagnostic-node diagnostic-node--fps"><ToolIcon kind="fps" size={18} /></span>
      <span class="diagnostic-node diagnostic-node--touch"><ToolIcon kind="touch" size={18} /></span>

      <svg class="diagnostic-wave" viewBox="0 0 180 40" preserveAspectRatio="none">
        <path d="M1 24h32l8 -12l12 20l11 -16l10 8h20l8 -10l9 18l10 -8h58" />
      </svg>
      <span class="diagnostic-label">signal / browser observed</span>
    </div>
  </section>

  <nav class="category-rail" aria-label="Hardware categories">
    {groups.map((group) => (
      <a href={`#${group.id}`} data-tone={group.tone}>
        <span class="category-rail__icon"><ToolIcon kind={group.icon} size={20} /></span>
        <span>{group.name}</span>
        <small>{group.tools.length}</small>
      </a>
    ))}
  </nav>

  <section class="home-tools" aria-labelledby="available-tools">
    <div class="home-tools__header">
      <div>
        <p class="home-kicker">Diagnostics catalog</p>
        <h2 id="available-tools">Choose a tool</h2>
      </div>
      <p>Each page does one job and explains what the browser can — and cannot — observe.</p>
    </div>

    <div class="tool-columns">
      {columns.map((column) => (
        <div class="tool-column">
          {column.map((group) => (
            <section class="tool-group" id={group.id} data-tone={group.tone} aria-labelledby={`tool-group-${group.id}`}>
              <header class="tool-group__header">
                <span class="tool-group__icon" aria-hidden="true"><ToolIcon kind={group.icon} size={20} /></span>
                <div>
                  <h3 id={`tool-group-${group.id}`}>{group.name}</h3>
                  <p>{group.tools.length} {group.tools.length === 1 ? 'tool' : 'tools'}</p>
                </div>
              </header>

              <div class="tool-list">
                {group.tools.map((tool) => (
                  <a class="tool-link" href={tool.href}>
                    <span class="tool-link__icon" aria-hidden="true"><ToolIcon kind={tool.icon} size={21} /></span>
                    <span class="tool-link__copy">
                      <strong>{tool.name}</strong>
                      <small>{tool.description}</small>
                    </span>
                    <span class="tool-link__arrow" aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: 14rem;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.42fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(1.6rem, 3.5vw, 2.5rem) clamp(1.5rem, 4vw, 3rem) 3.2rem;
    border: 1px solid #183740;
    border-radius: 19px;
    background: #112a32;
    color: #edf7f9;
    box-shadow: 0 24px 60px rgba(15, 39, 47, 0.16);
  }

  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0 0 0 54%;
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(135, 199, 212, 0.22) 1px, transparent 1px),
      linear-gradient(90deg, rgba(135, 199, 212, 0.22) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .home-hero__copy {
    position: relative;
    z-index: 2;
    max-width: 48rem;
  }

  .home-eyebrow,
  .home-kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .home-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.58rem;
    margin-bottom: var(--space-3);
    color: #8fb8c2;
  }

  .home-eyebrow span {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: #69c8dd;
    box-shadow: 0 0 0 4px rgba(105, 200, 221, 0.1);
  }

  .home-hero .page-heading {
    max-width: 42rem;
    margin-bottom: var(--space-3);
    color: #f4fbfc;
    font-size: clamp(2.5rem, 5vw, 4.35rem);
    line-height: 0.96;
    letter-spacing: -0.058em;
  }

  .home-hero .page-intro {
    max-width: 42rem;
    color: #a9bec4;
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.52;
  }

  .home-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: var(--space-5);
  }

  .home-facts span {
    min-width: 7.5rem;
    display: grid;
    gap: 0.06rem;
    padding: 0.52rem 0.72rem;
    border: 1px solid rgba(139, 203, 216, 0.13);
    border-radius: 10px;
    background: rgba(232, 248, 251, 0.035);
  }

  .home-facts strong {
    color: #dff8fc;
    font: 700 0.9rem var(--font-mono);
  }

  .home-facts small {
    color: #77959d;
    font-size: 0.67rem;
    line-height: 1.2;
  }

  .diagnostic-visual {
    position: relative;
    z-index: 1;
    width: min(100%, 19rem);
    aspect-ratio: 1;
    justify-self: end;
  }

  .diagnostic-grid {
    position: absolute;
    inset: 12%;
    border: 1px solid rgba(121, 196, 212, 0.12);
    border-radius: 20px;
    rotate: 7deg;
  }

  .diagnostic-grid::before,
  .diagnostic-grid::after {
    content: '';
    position: absolute;
    inset: 14%;
    border: 1px solid rgba(121, 196, 212, 0.09);
    border-radius: 14px;
  }

  .diagnostic-grid::after {
    inset: 29%;
    border-radius: 50%;
  }

  .diagnostic-ring,
  .diagnostic-axis,
  .diagnostic-core,
  .diagnostic-node {
    position: absolute;
  }

  .diagnostic-ring {
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    border: 1px solid rgba(121, 196, 212, 0.24);
    border-radius: 50%;
  }

  .diagnostic-ring--outer {
    width: 10.4rem;
    height: 10.4rem;
  }

  .diagnostic-ring--inner {
    width: 5.6rem;
    height: 5.6rem;
    border-color: rgba(105, 200, 221, 0.42);
  }

  .diagnostic-axis {
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background: rgba(121, 196, 212, 0.25);
  }

  .diagnostic-axis--x {
    width: 13rem;
    height: 1px;
  }

  .diagnostic-axis--y {
    width: 1px;
    height: 13rem;
  }

  .diagnostic-core {
    left: 50%;
    top: 50%;
    width: 0.75rem;
    height: 0.75rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: #78d9eb;
    box-shadow: 0 0 0 5px rgba(120, 217, 235, 0.1), 0 0 22px rgba(120, 217, 235, 0.24);
  }

  .diagnostic-core::after {
    content: '';
    position: absolute;
    inset: -0.45rem;
    border: 1px solid rgba(120, 217, 235, 0.35);
    border-radius: 50%;
  }

  .diagnostic-node {
    width: 2.35rem;
    height: 2.35rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(139, 203, 216, 0.2);
    border-radius: 11px;
    background: #173740;
    color: #9bdae7;
    box-shadow: 0 8px 18px rgba(5, 20, 25, 0.2);
  }

  .diagnostic-node--gamepad { left: 6%; top: 18%; }
  .diagnostic-node--mouse { right: 4%; top: 25%; }
  .diagnostic-node--fps { left: 13%; bottom: 11%; }
  .diagnostic-node--touch { right: 8%; bottom: 8%; }

  .diagnostic-wave {
    position: absolute;
    left: 17%;
    right: 17%;
    bottom: 22%;
    width: 66%;
    height: 2.25rem;
    overflow: visible;
  }

  .diagnostic-wave path {
    fill: none;
    stroke: rgba(120, 217, 235, 0.64);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .diagnostic-label {
    position: absolute;
    right: 9%;
    bottom: 1%;
    color: #64858e;
    font: 600 0.57rem var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .category-rail {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.6rem;
    margin: -1.45rem clamp(0.85rem, 2vw, 1.5rem) 0;
  }

  .category-rail a {
    --tone: #1688a8;
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    padding: 0.72rem 0.85rem;
    border: 1px solid #d7e2e5;
    border-radius: 12px;
    background: #fff;
    color: #26343a;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(27, 54, 64, 0.09);
    transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
  }

  .category-rail a:hover {
    color: #172126;
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--tone) 38%, #dbe4e7);
    box-shadow: 0 13px 28px rgba(27, 54, 64, 0.12);
  }

  .category-rail__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9px;
    color: var(--tone);
    background: color-mix(in srgb, var(--tone) 9%, white);
  }

  .category-rail a > span:nth-child(2) {
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .category-rail small {
    color: #829198;
    font: 0.72rem var(--font-mono);
  }

  [data-tone='blue'] { --tone: #4776cf; }
  [data-tone='cyan'] { --tone: #1688a8; }
  [data-tone='violet'] { --tone: #7668c5; }
  [data-tone='sky'] { --tone: #2d83b7; }
  [data-tone='teal'] { --tone: #258f83; }

  .home-tools {
    margin-top: var(--space-6);
  }

  .home-kicker {
    color: #54717c;
  }

  .home-tools__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-4);
  }

  .home-tools__header h2 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    letter-spacing: -0.03em;
  }

  .home-tools__header > p {
    max-width: 31rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .tool-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-5);
  }

  .tool-column {
    min-width: 0;
    display: grid;
    gap: var(--space-5);
  }

  .tool-group {
    --tone: #1688a8;
    min-width: 0;
    overflow: hidden;
    border: 1px solid #dce5e8;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 10px 28px rgba(27, 54, 64, 0.055);
    scroll-margin-top: 1rem;
  }

  .tool-group__header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1rem 0.8rem;
    border-bottom: 1px solid #e6ecee;
    background: color-mix(in srgb, var(--tone) 4%, #fbfcfc);
    box-shadow: inset 3px 0 0 color-mix(in srgb, var(--tone) 65%, white);
  }

  .tool-group__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    color: var(--tone);
    background: color-mix(in srgb, var(--tone) 9%, white);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tone) 14%, #e1e8ea);
  }

  .tool-group h3 {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .tool-group__header p {
    margin: 0.05rem 0 0;
    color: #819096;
    font-size: 0.7rem;
  }

  .tool-list {
    display: grid;
    padding: 0.35rem;
  }

  .tool-link {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.78rem 0.75rem;
    border-radius: 11px;
    text-decoration: none;
    transition: background 140ms ease, transform 140ms ease;
  }

  .tool-link + .tool-link {
    border-top: 1px solid #edf1f2;
    border-radius: 0;
  }

  .tool-link:hover {
    color: #172126;
    background: color-mix(in srgb, var(--tone) 5.5%, white);
    transform: translateX(2px);
  }

  .tool-link__icon {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid #e3e9eb;
    border-radius: 10px;
    color: var(--tone);
    background: #fbfcfc;
    transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
  }

  .tool-link:hover .tool-link__icon {
    transform: scale(1.04);
    border-color: color-mix(in srgb, var(--tone) 24%, #e3e9eb);
    background: color-mix(in srgb, var(--tone) 7%, white);
  }

  .tool-link__copy {
    min-width: 0;
  }

  .tool-link strong,
  .tool-link small {
    display: block;
  }

  .tool-link strong {
    color: #1f2b30;
    font-size: 0.9rem;
    line-height: 1.25;
  }

  .tool-link small {
    margin-top: 0.12rem;
    color: #6f7d83;
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .tool-link__arrow {
    color: #9aa8ad;
    transition: translate 140ms ease, color 140ms ease;
  }

  .tool-link:hover .tool-link__arrow {
    color: var(--tone);
    translate: 3px 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .diagnostic-core::after {
      animation: signal-pulse 2.8s ease-out infinite;
    }
  }

  @keyframes signal-pulse {
    0%, 55% { opacity: 0.65; scale: 1; }
    100% { opacity: 0; scale: 1.8; }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-rail a,
    .tool-link,
    .tool-link__icon,
    .tool-link__arrow {
      transition: none;
    }
  }

  @media (max-width: 52rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr) 12rem;
      gap: var(--space-4);
    }

    .diagnostic-visual {
      width: 12rem;
    }

    .diagnostic-node--fps,
    .diagnostic-node--touch,
    .diagnostic-label {
      display: none;
    }

    .category-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .tool-columns {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .home-hero {
      display: block;
      min-height: 21rem;
      padding: var(--space-5) var(--space-5) 3rem;
      border-radius: 16px;
    }

    .home-hero::before {
      inset: 48% -20% -15% 26%;
      opacity: 0.12;
    }

    .home-hero .page-heading {
      max-width: 19rem;
      font-size: clamp(2.25rem, 12vw, 3.15rem);
    }

    .home-hero .page-intro {
      position: relative;
      z-index: 2;
      max-width: 20rem;
      font-size: 0.94rem;
    }

    .home-facts {
      position: relative;
      z-index: 3;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.38rem;
      margin-top: var(--space-4);
    }

    .home-facts span {
      min-width: 0;
      padding: 0.5rem 0.52rem;
    }

    .home-facts strong {
      font-size: 0.76rem;
    }

    .home-facts small {
      font-size: 0.58rem;
    }

    .diagnostic-visual {
      position: absolute;
      right: -2.5rem;
      bottom: -3.2rem;
      width: 12rem;
      opacity: 0.52;
    }

    .diagnostic-node {
      width: 2rem;
      height: 2rem;
    }

    .diagnostic-node--mouse,
    .diagnostic-node--fps,
    .diagnostic-node--touch,
    .diagnostic-wave,
    .diagnostic-label {
      display: none;
    }

    .category-rail {
      display: flex;
      gap: 0.5rem;
      margin: -1.3rem 0.6rem 0;
      padding: 0 0.15rem 0.45rem;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }

    .category-rail::-webkit-scrollbar {
      display: none;
    }

    .category-rail a {
      flex: 0 0 8.5rem;
      scroll-snap-align: start;
      padding: 0.66rem 0.7rem;
    }

    .home-tools {
      margin-top: var(--space-5);
    }

    .home-tools__header {
      display: block;
    }

    .home-tools__header > p {
      margin-top: 0.5rem;
    }

    .tool-column,
    .tool-columns {
      gap: var(--space-4);
    }

    .tool-group {
      border-radius: 14px;
    }

    .tool-link {
      padding: 0.72rem 0.65rem;
