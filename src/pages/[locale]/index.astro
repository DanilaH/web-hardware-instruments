---
import HomePage from '../index.astro';
import { implementedContentLocales, type ImplementedContentLocale } from '../../i18n/content';
import { localeDefinitions } from '../../i18n/locales';

export function getStaticPaths() {
  return implementedContentLocales
    .filter((locale) => locale !== 'en')
    .map((locale) => ({
      params: { locale: localeDefinitions[locale].routeSegment },
      props: { locale },
    }));
}

interface Props {
  locale: ImplementedContentLocale;
}

const { locale } = Astro.props;
---

<HomePage locale={locale} />
