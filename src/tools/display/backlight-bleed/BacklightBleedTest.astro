---
import ToolShell from '../../../components/tool-shell/ToolShell.astro';
import DisplayInspectionStage from '../inspection/DisplayInspectionStage.astro';
---

<ToolShell labelledBy="backlight-tool-heading">
  <h2 id="backlight-tool-heading" class="backlight-tool__sr">Backlight Bleed Test controls</h2>

  <div class="backlight-tool" data-backlight-bleed-test data-active="false" data-fullscreen="false">
    <div class="backlight-tool__preflight">
      <div class="backlight-tool__status-row">
        <span class="backlight-tool__signal" aria-hidden="true"></span>
        <strong>Visual inspection</strong>
      </div>

      <p class="backlight-tool__instruction">Dim the room, then inspect a full black screen for obvious bright leakage or unevenness.</p>

      <button type="button" class="backlight-action backlight-action--primary" data-backlight-start>
        Start black screen
      </button>

      <p class="backlight-tool__context">Best for backlit LCD/LED displays. OLED panels do not use a backlight, so the same diagnosis does not apply.</p>
    </div>

    <DisplayInspectionStage
      label="Backlight bleed black-screen inspection stage"
      initialColor="#000000"
    >
      <div class="backlight-overlay">
        <div>
          <strong>Black inspection screen</strong>
          <span>Keep the room dim and inspect from your normal viewing position.</span>
        </div>
        <button type="button" data-inspection-control data-inspection-exit>Exit test</button>
      </div>
    </DisplayInspectionStage>

    <p class="backlight-tool__fullscreen-note" data-inspection-fullscreen-note role="status" aria-live="polite"></p>
  </div>
</ToolShell>

<script>
  import { mountBacklightBleedTest } from './backlight-bleed-controller';

  const root = document.querySelector<HTMLElement>('[data-backlight-bleed-test]');
  if (root) {
    const controller = mountBacklightBleedTest(root);
    window.addEventListener('pagehide', (event) => {
      if (event.persisted) {
        controller.stop();
        return;
      }
      controller.destroy();
    });
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) controller.start();
    });
  }
</script>

<style>
  .backlight-tool {
    display: grid;
    gap: var(--space-3);
  }

  .backlight-tool__preflight {
    display: grid;
    gap: var(--space-4);
  }

  .backlight-tool[data-active='true'] .backlight-tool__preflight {
    display: none;
  }

  .backlight-tool__status-row {
    min-height: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .backlight-tool__status-row strong {
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .backlight-tool__signal {
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-signal);
  }

  .backlight-tool__instruction,
  .backlight-tool__context,
  .backlight-tool__fullscreen-note {
    margin: 0;
  }

  .backlight-tool__instruction {
    max-width: 48rem;
    font-size: 0.95rem;
  }

  .backlight-tool__context,
  .backlight-tool__fullscreen-note {
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .backlight-tool__context {
    max-width: 48rem;
  }

  .backlight-action {
    min-height: 2.65rem;
    width: fit-content;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    background: #fff;
    padding: 0.55rem 0.9rem;
    color: var(--color-text);
    cursor: pointer;
  }

  .backlight-action--primary {
    border-color: var(--color-signal);
    background: color-mix(in srgb, var(--color-signal) 10%, white);
    font-weight: 650;
  }

  .backlight-overlay {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.78rem;
  }

  .backlight-overlay > div {
    display: grid;
    gap: 0.1rem;
  }

  .backlight-overlay strong {
    font-size: 0.88rem;
  }

  .backlight-overlay span {
    color: #c6cbcd;
    line-height: 1.35;
  }

  .backlight-overlay button {
    min-height: 2rem;
    flex: 0 0 auto;
    border: 1px solid #62696c;
    border-radius: 0.3rem;
    background: #242829;
    padding: 0.3rem 0.5rem;
    color: #fff;
    cursor: pointer;
  }

  .backlight-tool__fullscreen-note {
    min-height: 1.15rem;
  }

  .backlight-tool__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 40rem) {
    .backlight-action {
      width: 100%;
    }

    .backlight-overlay {
      align-items: flex-start;
      flex-wrap: wrap;
    }
  }
</style>
