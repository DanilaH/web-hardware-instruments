---
import ToolShell from '../../../components/tool-shell/ToolShell.astro';
---

<ToolShell labelledBy="polling-heading">
  <h2 id="polling-heading" class="sr-only">Mouse Polling Rate Test</h2>

  <div class="polling-test" data-mouse-polling-test>
    <div class="status">
      <span aria-hidden="true"></span>
      <strong data-polling-status role="status" aria-live="polite">Ready to measure</strong>
    </div>

    <p class="instruction">Start the 2-second test, then move continuously inside the sampling area.</p>

    <div class="surface">
      <div class="move-field" data-polling-surface aria-label="Mouse movement sampling area">
        <span aria-hidden="true">MOVE CONTINUOUSLY</span>
        <i aria-hidden="true"></i>
      </div>

      <div class="result">
        <span>Observed pointer sample rate</span>
        <strong data-polling-rate>—</strong>
        <dl>
          <div>
            <dt>Source</dt>
            <dd data-polling-source>Waiting</dd>
          </div>
        </dl>
        <button type="button" class="tool-action tool-action--primary" data-polling-start>Start 2-second test</button>
      </div>
    </div>

    <p class="note">
      Browsers and operating systems can merge, limit, or reschedule pointer events, so this may differ from the mouse's configured hardware polling rate.
    </p>
  </div>
</ToolShell>

<script>
  import { mountMousePollingTest } from './mouse-polling-controller';

  const root = document.querySelector<HTMLElement>('[data-mouse-polling-test]');
  if (root) {
    const controller = mountMousePollingTest(root);
    window.addEventListener('pagehide', (event) =>
      event.persisted ? controller.stop() : controller.destroy(),
    );
  }
</script>

<style>
  .polling-test {
    display: grid;
    gap: var(--space-4);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .status span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-signal);
  }

  .instruction,
  .note {
    margin: 0;
  }

  .surface {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(19rem, 0.75fr);
    gap: var(--space-5);
    padding: var(--space-4);
    border: 1px solid #e3e6e7;
    background: #fafbfb;
    user-select: none;
  }

  .move-field {
    min-height: 17rem;
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    border: 1px solid #dfe3e4;
    background: #f7f9f9;
    color: var(--color-muted);
    font: 600 0.72rem var(--font-mono);
    letter-spacing: 0.08em;
  }

  .move-field::before,
  .move-field::after {
    content: '';
    position: absolute;
    background: #e2e6e7;
    pointer-events: none;
  }

  .move-field::before {
    width: 1px;
    height: 72%;
  }

  .move-field::after {
    width: 72%;
    height: 1px;
  }

  .move-field i {
    position: absolute;
    width: 55%;
    height: 1px;
    background: var(--color-signal);
    opacity: 0.55;
  }

  .move-field span {
    position: relative;
    z-index: 1;
    background: #f7f9f9;
    padding: 0.35rem 0.55rem;
  }

  .result {
    display: grid;
    align-content: center;
    gap: var(--space-3);
    padding-left: var(--space-5);
    border-left: 1px solid #dfe3e4;
  }

  .result > span,
  .result dt {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .result > strong {
    font: 650 clamp(2.3rem, 5vw, 4rem) / 1 var(--font-mono);
  }

  dl {
    margin: 0;
  }

  dl div {
    display: grid;
    gap: 0.25rem;
  }

  dd {
    margin: 0;
    font-size: 0.9rem;
  }

  .result .tool-action {
    justify-self: start;
  }

  .note {
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    .surface {
      grid-template-columns: 1fr;
    }

    .result {
      order: -1;
      padding: 0 0 var(--space-4);
      border-left: 0;
      border-bottom: 1px solid #dfe3e4;
    }

    .move-field {
      min-height: 12rem;
    }
  }

  @media (max-width: 40rem) {
    .surface {
      padding: var(--space-3);
    }

    .move-field {
      min-height: 9rem;
    }
  }
</style>
