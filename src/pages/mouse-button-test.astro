---
import RelatedTools from '../components/navigation/RelatedTools.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import MouseButtonTest from '../tools/mouse/button/MouseButtonTest.astro';

const relatedTools = [
  {
    href: '/mouse-tester',
    name: 'Mouse Tester',
    description: 'Check buttons, wheel input, and movement together.',
  },
  {
    href: '/double-click-test',
    name: 'Double Click Test',
    description: 'Look for unusually fast repeated presses while clicking slowly.',
  },
] as const;
---

<BaseLayout
  title="Mouse Button Test — Check Mouse Buttons Online"
  description="Test primary, middle, secondary, back, and forward mouse button input directly in your browser."
  canonicalPath="/mouse-button-test"
>
  <section class="reading-width">
    <h1 class="page-heading">Mouse Button Test</h1>
    <p class="page-intro">See which semantic mouse button inputs this browser receives.</p>
  </section>

  <MouseButtonTest />

  <section class="tool-content reading-width">
    <h2>How to test mouse buttons</h2>
    <p>
      Press each button inside the test area. Held highlighting shows the current browser state and the counter records button-down events.
    </p>

    <h2>What the result means</h2>
    <p>
      Detected means the browser received that semantic button role. Primary and Secondary can reflect OS remapping, and an untested side button is not automatically a failure.
    </p>
  </section>

  <RelatedTools tools={relatedTools} />
</BaseLayout>

<style>
  .tool-content {
    margin-top: var(--space-7);
    padding-bottom: var(--space-7);
  }

  .tool-content h2 {
    margin: var(--space-6) 0 var(--space-2);
    font-size: 1.15rem;
  }

  .tool-content p {
    color: var(--color-muted);
    line-height: 1.65;
  }
</style>
