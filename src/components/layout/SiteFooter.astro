---
import { getSiteContent, type ImplementedContentLocale } from '../../i18n/content';
import { buildLocalizedPath } from '../../i18n/routing';

interface Props {
  locale?: ImplementedContentLocale;
}

const { locale = 'en' } = Astro.props;
const content = getSiteContent(locale);
---

<footer class="site-footer">
  <div class="site-footer__inner shell-width">
    <span>{content.footer.privacyNote}</span>
    <nav aria-label={content.footer.navigationAria}>
      <a href={buildLocalizedPath(locale, '/about')}>{content.footer.about}</a>
      <a href={buildLocalizedPath(locale, '/privacy')}>{content.footer.privacy}</a>
    </nav>
  </div>
</footer>
