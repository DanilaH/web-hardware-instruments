---
import { siteConfig } from '../../config/site';
import type { AlternateLink } from '../../i18n/routing';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  alternates?: readonly AlternateLink[];
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  canonicalPath = Astro.url.pathname,
  alternates = [],
  noindex = false,
} = Astro.props;

const canonicalUrl = canonicalPath === '/'
  ? siteConfig.origin
  : new URL(canonicalPath, siteConfig.origin).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:site_name" content={siteConfig.name} />
<link rel="canonical" href={canonicalUrl} />
{alternates.map((alternate) => (
  <link rel="alternate" hreflang={alternate.hreflang} href={new URL(alternate.path, siteConfig.origin).href} />
))}
{noindex && <meta name="robots" content="noindex, nofollow" />}
