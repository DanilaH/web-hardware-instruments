---
import ToolShell from '../../../components/tool-shell/ToolShell.astro';
import type { ImplementedContentLocale } from '../../../i18n/content';
import { getScreenUniformityRuntimeMessages } from '../../../i18n/runtime/screen-uniformity';
import DisplayInspectionStage from '../inspection/DisplayInspectionStage.astro';
import DisplayPatternSurface from '../pattern-engine/DisplayPatternSurface.astro';
import { screenUniformityPatterns } from '../pattern-engine/display-patterns';

interface Props { locale?: ImplementedContentLocale; }
const { locale = 'en' } = Astro.props;
const messages = getScreenUniformityRuntimeMessages(locale);
---

<ToolShell labelledBy="screen-uniformity-tool-heading">
  <h2 id="screen-uniformity-tool-heading" class="uniformity-tool__sr">{messages.controlsHeading}</h2>

  <div
    class="uniformity-tool"
    data-screen-uniformity-test
    data-messages={JSON.stringify(messages)}
    data-active="false"
    data-fullscreen="false"
  >
    <div class="uniformity-tool__preflight">
      <div class="uniformity-tool__status-row">
        <span class="uniformity-tool__signal" aria-hidden="true"></span>
        <strong>{messages.visualInspection}</strong>
      </div>
      <p class="uniformity-tool__instruction">{messages.instruction}</p>
      <button type="button" class="uniformity-action uniformity-action--primary" data-uniformity-start>{messages.start}</button>
      <div class="uniformity-tool__sequence" aria-label={messages.sequenceAria}>
        {screenUniformityPatterns.map((pattern, index) => (
          <span class="uniformity-chip" data-pattern-id={pattern.id}>{messages.patterns[index]}</span>
        ))}
      </div>
    </div>

    <DisplayInspectionStage label={messages.stageAria} interactive={true}>
      <DisplayPatternSurface slot="surface" />
      <div class="uniformity-overlay">
        <div class="uniformity-overlay__result" role="status" aria-live="polite" aria-atomic="true">
          <strong data-uniformity-pattern-label>{messages.patterns[0]}</strong>
          <span data-uniformity-pattern-position>1 / {screenUniformityPatterns.length}</span>
        </div>
        <span class="uniformity-overlay__hint">{messages.nextHint}</span>
        <div class="uniformity-overlay__controls">
          <button type="button" data-inspection-control data-uniformity-previous>{messages.previous}</button>
          <button type="button" data-inspection-control data-uniformity-next>{messages.next}</button>
          <button type="button" data-inspection-control data-uniformity-hide>{messages.hideControls}</button>
          <button type="button" data-inspection-control data-inspection-exit>{messages.exit}</button>
        </div>
      </div>
    </DisplayInspectionStage>

    <p class="uniformity-tool__fullscreen-note" data-inspection-fullscreen-note role="status" aria-live="polite"></p>
  </div>
</ToolShell>

<script>
  import type { ScreenUniformityRuntimeMessages } from '../../../i18n/runtime/screen-uniformity';
  import { mountDisplayPatternEngine } from '../pattern-engine/display-pattern-engine';
  import { screenUniformityPatterns } from '../pattern-engine/display-patterns';

  const requireElement = <T extends Element>(root: ParentNode, selector: string): T => {
    const element = root.querySelector<T>(selector);
    if (!element) throw new Error(`Screen Uniformity Test is missing ${selector}`);
    return element;
  };

  const root = document.querySelector<HTMLElement>('[data-screen-uniformity-test]');
  if (root) {
    const messages = JSON.parse(root.dataset.messages ?? '{}') as ScreenUniformityRuntimeMessages;
    const stage = requireElement<HTMLElement>(root, '[data-inspection-stage]');
    const controller = mountDisplayPatternEngine({
      root,
      stage,
      startButton: requireElement<HTMLButtonElement>(root, '[data-uniformity-start]'),
      exitButton: requireElement<HTMLButtonElement>(root, '[data-inspection-exit]'),
      previousButton: requireElement<HTMLButtonElement>(root, '[data-uniformity-previous]'),
      nextButton: requireElement<HTMLButtonElement>(root, '[data-uniformity-next]'),
      hideButton: requireElement<HTMLButtonElement>(root, '[data-uniformity-hide]'),
      fullscreenNote: requireElement<HTMLElement>(root, '[data-inspection-fullscreen-note]'),
      patternSurface: requireElement<HTMLElement>(root, '[data-display-pattern-surface]'),
      patternLabel: requireElement<HTMLElement>(root, '[data-uniformity-pattern-label]'),
      patternPosition: requireElement<HTMLElement>(root, '[data-uniformity-pattern-position]'),
      patterns: screenUniformityPatterns,
      labels: messages.patterns,
      fullscreenUnavailableMessage: messages.fullScreenUnavailable,
    });

    window.addEventListener('pagehide', (event) => {
      if (event.persisted) {
        controller.stop();
        return;
      }
      controller.destroy();
    });
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) controller.start();
    });
  }
</script>

<style>
  .uniformity-tool { display: grid; gap: var(--space-3); }
  .uniformity-tool__preflight { display: grid; gap: var(--space-4); }
  .uniformity-tool[data-active='true'] .uniformity-tool__preflight { display: none; }
  .uniformity-tool__status-row { min-height: 1.5rem; display: flex; align-items: center; gap: 0.55rem; color: var(--color-muted); font-size: 0.85rem; }
  .uniformity-tool__status-row strong { color: var(--color-text); font-size: 0.9rem; }
  .uniformity-tool__signal { width: 0.55rem; height: 0.55rem; flex: 0 0 auto; border-radius: 50%; background: var(--color-signal); }
  .uniformity-tool__instruction, .uniformity-tool__fullscreen-note { margin: 0; }
  .uniformity-tool__instruction { max-width: 52rem; font-size: 0.95rem; }
  .uniformity-action { min-height: 2.65rem; width: fit-content; border: 1px solid var(--color-border); border-radius: 0.35rem; background: #fff; padding: 0.55rem 0.9rem; color: var(--color-text); cursor: pointer; }
  .uniformity-action--primary { border-color: var(--color-signal); background: color-mix(in srgb, var(--color-signal) 10%, white); font-weight: 650; }
  .uniformity-tool__sequence { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .uniformity-chip { display: inline-flex; align-items: center; min-height: 1.8rem; border: 1px solid var(--color-border); border-radius: 999px; padding: 0.25rem 0.48rem; color: var(--color-muted); font-size: 0.72rem; }
  .uniformity-overlay { display: grid; gap: 0.45rem; min-width: min(29rem, 100%); font-size: 0.78rem; }
  .uniformity-overlay__result { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .uniformity-overlay__result strong { font-size: 0.9rem; }
  .uniformity-overlay__result span, .uniformity-overlay__hint { color: #c6cbcd; }
  .uniformity-overlay__controls { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .uniformity-overlay button { min-height: 2rem; border: 1px solid #62696c; border-radius: 0.3rem; background: #242829; padding: 0.3rem 0.5rem; color: #fff; cursor: pointer; }
  .uniformity-tool__fullscreen-note { min-height: 1.15rem; color: var(--color-muted); font-size: 0.78rem; }
  .uniformity-tool__sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 40rem) {
    .uniformity-action { width: 100%; }
    .uniformity-overlay { min-width: 0; }
    .uniformity-overlay__result { align-items: flex-start; flex-direction: column; gap: 0.1rem; }
    .uniformity-overlay__controls button { flex: 1 1 auto; }
  }
</style>
