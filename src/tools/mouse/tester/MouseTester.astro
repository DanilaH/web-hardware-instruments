---
import ToolShell from '../../../components/tool-shell/ToolShell.astro';
import StandardMouseVisual from '../../../visuals/mouse/StandardMouseVisual.astro';
---

<ToolShell labelledBy="mouse-tester-tool-heading">
  <h2 id="mouse-tester-tool-heading" class="mouse-tester__sr">Mouse Tester controls</h2>

  <div class="mouse-tester" data-mouse-tester data-state="ready">
    <div class="mouse-tester__status-row">
      <span class="mouse-tester__signal" aria-hidden="true"></span>
      <strong data-mouse-status role="status" aria-live="polite" aria-atomic="true">Listening for mouse input</strong>
      <span class="mouse-tester__status-note">Listening automatically.</span>
    </div>

    <p class="mouse-tester__instruction">Move, click, and scroll inside the test area for a quick input check.</p>

    <div class="mouse-tester__surface" data-mouse-test-surface>
      <div class="mouse-tester__visual-column">
        <StandardMouseVisual />
        <p class="mouse-tester__semantic-note">
          This is a quick live overview. Use Mouse Button Test for per-button detection and press counts.
        </p>
      </div>

      <div class="mouse-tester__results" aria-label="Browser-detected mouse input overview">
        <div class="mouse-result__heading tool-result-heading">
          <span>Live input overview</span>
          <button type="button" class="mouse-reset tool-action tool-action--quiet" data-mouse-reset>Reset</button>
        </div>

        <div class="overview-results">
          <div class="overview-result">
            <span>Last button</span>
            <strong class="measurement-value" data-mouse-last-button>Waiting</strong>
          </div>
          <div class="overview-result">
            <span>Button roles seen</span>
            <strong class="measurement-value" data-mouse-roles-seen>0 / 5</strong>
          </div>
          <div class="overview-result">
            <span>Wheel</span>
            <strong data-mouse-wheel>Waiting</strong>
          </div>
          <div class="overview-result">
            <span>Movement</span>
            <strong data-mouse-movement>Waiting</strong>
          </div>
        </div>
      </div>
    </div>

    <p class="mouse-tester__note" data-mouse-note>
      Inside this test surface, normal browser actions for tested mouse input — including X1/X2 Back/Forward navigation — are suppressed when the browser exposes those events. Outside the surface, normal mouse behavior is unchanged.
    </p>

    <p class="mouse-tester__sr" data-mouse-accessible-summary>
      Mouse Tester is listening. Move, click, or scroll inside the test area.
    </p>
  </div>
</ToolShell>

<script>
  import { mountMouseTester } from './mouse-tester-controller';

  const root = document.querySelector<HTMLElement>('[data-mouse-tester]');
  if (root) {
    const controller = mountMouseTester(root);
    window.addEventListener('pagehide', (event) => {
      if (event.persisted) {
        controller.stop();
        return;
      }
      controller.destroy();
    });
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        controller.start();
      }
    });
  }
</script>

<style>
  .mouse-tester {
    display: grid;
    gap: var(--space-4);
  }

  .mouse-tester__status-row {
    min-height: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .mouse-tester__status-row strong {
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .mouse-tester__status-note {
    margin-left: auto;
  }

  .mouse-tester__signal {
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 auto;
    border: 1px solid var(--color-signal);
    border-radius: 50%;
    background: var(--color-signal);
  }

  .mouse-tester[data-state='unavailable'] .mouse-tester__signal {
    border-color: #8c5555;
    background: #b36a6a;
  }

  .mouse-tester__instruction,
  .mouse-tester__note,
  .mouse-tester__semantic-note {
    margin: 0;
  }

  .mouse-tester__instruction {
    font-size: 0.95rem;
  }

  .mouse-tester__surface {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 0.7fr);
    gap: var(--space-5);
    min-height: 20rem;
    padding: var(--space-4);
    border: 1px solid #e3e6e7;
    background: #fafbfb;
    user-select: none;
  }

  .mouse-tester__visual-column {
    min-width: 0;
    display: grid;
    align-content: center;
    gap: var(--space-2);
  }

  .mouse-tester__semantic-note,
  .mouse-tester__note {
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .mouse-tester__semantic-note {
    max-width: 31rem;
    margin-inline: auto;
    text-align: center;
  }

  .mouse-tester__results {
    align-self: stretch;
    display: grid;
    align-content: center;
    gap: var(--space-4);
    padding-left: var(--space-5);
    border-left: 1px solid #dfe3e4;
  }

  .mouse-result__heading > span,
  .overview-result > span {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.055em;
  }

  .overview-results {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .overview-result {
    min-width: 0;
    display: grid;
    gap: 0.2rem;
    min-height: 4.25rem;
    align-content: center;
    padding: 0.65rem 0.7rem;
    border: 1px solid #e2e5e6;
    background: rgba(255, 255, 255, 0.78);
  }

  .overview-result strong {
    min-width: 0;
    overflow: hidden;
    color: var(--color-text);
    font: 600 0.95rem/1.25 var(--font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mouse-tester[data-state='detected'] .overview-result strong {
    color: var(--color-signal);
  }

  .mouse-tester__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 48rem) {
    .mouse-tester__surface {
      grid-template-columns: 1fr;
    }

    .mouse-tester__results {
      padding: var(--space-4) 0 0;
      border-left: 0;
      border-top: 1px solid #dfe3e4;
    }
  }

  @media (max-width: 40rem) {
    .mouse-tester__status-row {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .mouse-tester__status-note {
      width: 100%;
      margin-left: 1.1rem;
    }

    .mouse-tester__surface {
      min-height: 0;
      padding: var(--space-3);
    }
  }

  @media (max-width: 22rem) {
    .overview-results {
      grid-template-columns: 1fr;
    }
  }
</style>
