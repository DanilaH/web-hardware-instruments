---
import ToolIcon from '../components/icons/ToolIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const controllerTools = [
  { href: '/gamepad-tester', icon: 'gamepad', name: 'Gamepad Tester', description: 'Test controller buttons, sticks, D-pad, and triggers.' },
  { href: '/controller-stick-drift-test', icon: 'drift', name: 'Controller Stick Drift Test', description: 'Measure observed analog-stick center offset while untouched.' },
  { href: '/controller-deadzone-test', icon: 'deadzone', name: 'Controller Deadzone Test', description: 'Measure stick center noise and a heuristic starting deadzone.' },
] as const;

const mouseTools = [
  { href: '/mouse-tester', icon: 'mouse', name: 'Mouse Tester', description: 'Check browser-detected mouse buttons, wheel input, and movement.' },
  { href: '/mouse-button-test', icon: 'button', name: 'Mouse Button Test', description: 'Check primary, middle, secondary, back, and forward button input.' },
  { href: '/mouse-scroll-test', icon: 'scroll', name: 'Mouse Scroll Test', description: 'Inspect browser-detected wheel directions and recent events.' },
  { href: '/double-click-test', icon: 'double-click', name: 'Double Click Test', description: 'Look for unusually fast repeated same-button presses.' },
  { href: '/mouse-polling-rate-test', icon: 'polling', name: 'Mouse Polling Rate Test', description: 'Measure the pointer sample rate observed by this browser.' },
  { href: '/mouse-dpi-test', icon: 'dpi', name: 'Mouse DPI Test', description: 'Estimate mouse DPI from a measured physical movement distance.' },
] as const;

const keyboardTools = [
  { href: '/keyboard-tester', icon: 'keyboard', name: 'Keyboard Tester', description: 'Press keys and see which physical key codes the browser detects.' },
  { href: '/keyboard-rollover-test', icon: 'rollover', name: 'Keyboard Rollover Test', description: 'See the largest simultaneous key set this browser detects.' },
  { href: '/keyboard-ghosting-test', icon: 'ghosting', name: 'Keyboard Ghosting Test', description: 'Compare guided key combinations with the keys detected together.' },
] as const;

const displayTools = [
  { href: '/fps-test', icon: 'fps', name: 'FPS Test', description: 'Observe this browser page’s frame delivery and recent drops.' },
  { href: '/refresh-rate-test', icon: 'refresh', name: 'Refresh Rate Test', description: 'Estimate the display cadence currently visible to the browser.' },
  { href: '/frame-skipping-test', icon: 'frame-skip', name: 'Frame Skipping Test', description: 'Use a camera-assisted pattern to look for repeatable skipped-refresh gaps.' },
  { href: '/dead-pixel-test', icon: 'dead-pixel', name: 'Dead Pixel Test', description: 'Inspect the screen against solid colors for dead or stuck pixels.' },
  { href: '/backlight-bleed-test', icon: 'backlight', name: 'Backlight Bleed Test', description: 'Inspect a backlit display for bright leakage on a black screen.' },
] as const;

const touchTools = [
  { href: '/touch-screen-test', icon: 'touch', name: 'Touch Screen Test', description: 'Map browser-detected finger coverage, multi-touch, and unexpected touch input.' },
] as const;

const groups = [
  { code: '01', id: 'controller', name: 'Controller', icon: 'gamepad', tools: controllerTools },
  { code: '02', id: 'mouse', name: 'Mouse', icon: 'mouse', tools: mouseTools },
  { code: '03', id: 'keyboard', name: 'Keyboard', icon: 'keyboard', tools: keyboardTools },
  { code: '04', id: 'display', name: 'Display', icon: 'refresh', tools: displayTools },
  { code: '05', id: 'touch', name: 'Touch', icon: 'touch', tools: touchTools },
] as const;

const columns = [[groups[0], groups[1]], [groups[2], groups[3], groups[4]]] as const;
---

<BaseLayout
  title="Hardware Tests in Your Browser"
  description="Lightweight browser-based hardware diagnostics. No install or account required."
  canonicalPath="/"
  headerVariant="homepage"
>
  <section class="home-hero">
    <div class="home-hero__copy">
      <p class="home-eyebrow">Browser hardware diagnostics</p>
      <h1 class="page-heading">Hardware Tests in Your Browser</h1>
      <p class="page-intro">
        Focused diagnostics for controllers, mice, keyboards, displays, and touchscreens — built to show what the browser actually detects.
      </p>
      <p class="home-facts">18 focused tools <span>/</span> no install <span>/</span> raw input stays local</p>
    </div>

    <div class="signal-map" aria-label="Hardware input is observed through browser APIs and remains local">
      <p class="signal-map__title">What this site can observe</p>
      <div class="signal-map__flow">
        <div class="signal-map__inputs" aria-hidden="true">
          <span><ToolIcon kind="gamepad" size={17} />Controller</span>
          <span><ToolIcon kind="mouse" size={17} />Pointer</span>
          <span><ToolIcon kind="keyboard" size={17} />Keyboard</span>
          <span><ToolIcon kind="fps" size={17} />Frames</span>
          <span><ToolIcon kind="touch" size={17} />Touch</span>
        </div>
        <div class="signal-map__browser" aria-hidden="true">
          <small>Browser boundary</small>
          <strong>Native APIs</strong>
        </div>
        <div class="signal-map__result" aria-hidden="true">
          <strong>Observed here</strong>
          <small>No raw-input upload</small>
        </div>
      </div>
    </div>
  </section>

  <nav class="category-rail" aria-label="Hardware categories">
    {groups.map((group) => (
      <a href={`#${group.id}`}>
        <small>{group.code}</small>
        <span class="category-rail__icon"><ToolIcon kind={group.icon} size={18} /></span>
        <span>{group.name}</span>
      </a>
    ))}
  </nav>

  <section class="home-tools" aria-labelledby="available-tools">
    <div class="home-tools__header">
      <div>
        <p class="home-kicker">Diagnostics catalog</p>
        <h2 id="available-tools">Choose a tool</h2>
      </div>
      <p>Each page does one job and explains what the browser can — and cannot — observe.</p>
    </div>

    <div class="tool-columns">
      {columns.map((column) => (
        <div class="tool-column">
          {column.map((group) => (
            <section class="tool-group" id={group.id} aria-labelledby={`tool-group-${group.id}`}>
              <header class="tool-group__header">
                <span class="tool-group__code" aria-hidden="true">{group.code}</span>
                <span class="tool-group__icon" aria-hidden="true"><ToolIcon kind={group.icon} size={20} /></span>
                <div>
                  <h3 id={`tool-group-${group.id}`}>{group.name}</h3>
                  <p>{group.tools.length} {group.tools.length === 1 ? 'tool' : 'tools'}</p>
                </div>
              </header>

              <div class="tool-list">
                {group.tools.map((tool) => (
                  <a class="tool-link" href={tool.href}>
                    <span class="tool-link__icon" aria-hidden="true"><ToolIcon kind={tool.icon} size={20} /></span>
                    <span class="tool-link__copy">
                      <strong>{tool.name}</strong>
                      <small>{tool.description}</small>
                    </span>
                    <span class="tool-link__arrow" aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: 13rem;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.44fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(1.5rem, 3vw, 2.2rem) clamp(1.5rem, 4vw, 3rem) 2.4rem;
    border: 1px solid #373b3b;
    border-radius: 6px;
    background: #191c1d;
    color: #f1eee7;
  }

  .home-hero__copy {
    position: relative;
    z-index: 2;
    max-width: 48rem;
  }

  .home-eyebrow,
  .home-kicker {
    margin: 0;
    color: #8f9795;
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.045em;
  }

  .home-eyebrow {
    margin-bottom: var(--space-3);
  }

  .home-hero .page-heading {
    max-width: 42rem;
    margin-bottom: var(--space-3);
    color: #f5f1e8;
    font-size: clamp(2.4rem, 5vw, 4.15rem);
    line-height: 0.97;
    letter-spacing: -0.052em;
  }

  .home-hero .page-intro {
    max-width: 42rem;
    color: #a8aeac;
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    line-height: 1.52;
  }

  .home-facts {
    margin: var(--space-4) 0 0;
    color: #858d8b;
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .home-facts span {
    margin-inline: 0.45rem;
    color: #555c5b;
  }

  .signal-map {
    position: relative;
    z-index: 1;
    min-width: 0;
    justify-self: stretch;
    border: 1px solid #3e4443;
    background: #171a1b;
  }

  .signal-map::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 1rem;
    width: 2px;
    height: 2.6rem;
    background: #d96b45;
  }

  .signal-map__title {
    margin: 0;
    padding: 0.58rem 0.7rem;
    border-bottom: 1px solid #353a39;
    color: #858d8b;
    font-size: 0.64rem;
    font-weight: 650;
  }

  .signal-map__flow {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(5rem, 0.8fr) minmax(5.4rem, 0.9fr);
    min-height: 10.4rem;
  }

  .signal-map__inputs,
  .signal-map__browser,
  .signal-map__result {
    min-width: 0;
  }

  .signal-map__inputs {
    display: grid;
    align-content: center;
    border-right: 1px solid #353a39;
  }

  .signal-map__inputs span {
    display: grid;
    grid-template-columns: 1.35rem minmax(0, 1fr);
    align-items: center;
    gap: 0.42rem;
    min-width: 0;
    padding: 0.3rem 0.55rem;
    color: #b8bcb8;
    font-size: 0.62rem;
  }

  .signal-map__inputs span + span {
    border-top: 1px solid #292e2d;
  }

  .signal-map__inputs svg {
    color: #777f7d;
  }

  .signal-map__browser,
  .signal-map__result {
    position: relative;
    display: grid;
    place-content: center;
    gap: 0.18rem;
    padding: 0.7rem;
    text-align: center;
  }

  .signal-map__browser {
    border-right: 1px solid #353a39;
    background:
      linear-gradient(rgba(239, 234, 222, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(239, 234, 222, 0.045) 1px, transparent 1px);
    background-size: 14px 14px;
  }

  .signal-map__browser::before,
  .signal-map__result::before {
    content: '→';
    position: absolute;
    left: -0.42rem;
    top: 50%;
    translate: 0 -50%;
    padding: 0.05rem 0.12rem;
    background: #171a1b;
    color: #6e7674;
    font-size: 0.72rem;
  }

  .signal-map__browser small,
  .signal-map__result small {
    color: #747c7a;
    font-size: 0.56rem;
    line-height: 1.25;
  }

  .signal-map__browser strong,
  .signal-map__result strong {
    color: #ddd9d0;
    font-size: 0.7rem;
    line-height: 1.2;
  }

  .signal-map__result strong {
    color: #e1b39f;
  }

  .category-rail {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: -1px 0 0;
    border: 1px solid #cfd2cf;
    border-top: 0;
    border-radius: 0 0 6px 6px;
    background: #f2efe8;
  }

  .category-rail a {
    min-width: 0;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: 0.55rem;
    padding: 0.68rem 0.78rem;
    border-right: 1px solid #d7d9d5;
    color: #2b3030;
    text-decoration: none;
    transition: background 120ms ease, color 120ms ease;
  }

  .category-rail a:last-child {
    border-right: 0;
  }

  .category-rail a:hover {
    color: #171a1b;
    background: #eae7df;
  }

  .category-rail small {
    color: #8a8f8c;
    font: 600 0.56rem var(--font-mono);
    letter-spacing: 0.05em;
  }

  .category-rail__icon {
    display: grid;
    place-items: center;
    color: #626a68;
    transition: color 120ms ease;
  }

  .category-rail a:hover .category-rail__icon {
    color: #b85f40;
  }

  .category-rail a > span:nth-child(3) {
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.79rem;
    font-weight: 720;
  }

  .home-tools {
    margin-top: var(--space-6);
  }

  .home-tools__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid #cfd3d1;
  }

  .home-tools__header h2 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.45rem, 2.5vw, 1.95rem);
    letter-spacing: -0.035em;
  }

  .home-tools__header > p {
    max-width: 31rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .tool-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-5);
  }

  .tool-column {
    min-width: 0;
    display: grid;
    gap: var(--space-5);
  }

  .tool-group {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #cfd3d1;
    border-radius: 6px;
    background: #faf9f5;
    scroll-margin-top: 1rem;
  }

  .tool-group__header {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    padding: 0.72rem 0.82rem;
    border-bottom: 1px solid #d8dbd8;
    background: #f0ede6;
  }

  .tool-group__code {
    color: #929793;
    font: 600 0.57rem var(--font-mono);
    letter-spacing: 0.06em;
  }

  .tool-group__icon {
    display: grid;
    place-items: center;
    color: #5d6563;
  }

  .tool-group h3 {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: -0.01em;
  }

  .tool-group__header p {
    margin: 0.04rem 0 0;
    color: #8b918e;
    font-size: 0.64rem;
    font-weight: 600;
  }

  .tool-list {
    display: grid;
  }

  .tool-link {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.72rem;
    padding: 0.76rem 0.82rem;
    text-decoration: none;
    transition: background 110ms ease;
  }

  .tool-link + .tool-link {
    border-top: 1px solid #e1e3e0;
  }

  .tool-link:hover {
    color: #171a1b;
    background: #f2efe8;
  }

  .tool-link__icon {
    display: grid;
    place-items: center;
    color: #555d5b;
    transition: color 110ms ease, translate 110ms ease;
  }

  .tool-link:hover .tool-link__icon {
    color: #b85f40;
    translate: 1px 0;
  }

  .tool-link__copy {
    min-width: 0;
  }

  .tool-link strong,
  .tool-link small {
    display: block;
  }

  .tool-link strong {
    color: #242a29;
    font-size: 0.88rem;
    line-height: 1.25;
  }

  .tool-link small {
    margin-top: 0.1rem;
    color: #717875;
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .tool-link__arrow {
    color: #9ca09d;
    transition: translate 110ms ease, color 110ms ease;
  }

  .tool-link:hover .tool-link__arrow {
    color: #b85f40;
    translate: 3px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .category-rail a,
    .category-rail__icon,
    .tool-link,
    .tool-link__icon,
    .tool-link__arrow {
      transition: none;
    }
  }

  @media (max-width: 52rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr) 14rem;
      gap: var(--space-4);
    }

    .signal-map__flow {
      grid-template-columns: 1fr 0.9fr;
    }

    .signal-map__result {
      grid-column: 1 / -1;
      border-top: 1px solid #353a39;
    }

    .signal-map__browser {
      border-right: 0;
    }

    .signal-map__result::before {
      left: 50%;
      top: -0.45rem;
      rotate: 90deg;
    }

    .category-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .category-rail a:nth-child(3) {
      border-right: 0;
    }

    .category-rail a:nth-child(n + 4) {
      border-top: 1px solid #d7d9d5;
    }

    .tool-columns {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .home-hero {
      display: block;
      min-height: auto;
      padding: var(--space-5) var(--space-5) 1.35rem;
      border-radius: 4px;
    }

    .home-hero .page-heading {
      max-width: 19rem;
      font-size: clamp(2.15rem, 11.5vw, 3rem);
    }

    .home-hero .page-intro {
      max-width: 20rem;
      font-size: 0.92rem;
    }

    .home-facts {
      margin-top: var(--space-3);
      font-size: 0.66rem;
      line-height: 1.45;
    }

    .home-facts span {
      margin-inline: 0.28rem;
    }

    .signal-map {
      display: none;
    }

    .category-rail {
      display: flex;
      gap: 0;
      margin: -1px 0 0;
      padding: 0;
      overflow-x: auto;
      border-radius: 0 0 4px 4px;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }

    .category-rail::-webkit-scrollbar {
      display: none;
    }

    .category-rail a {
      flex: 0 0 8.7rem;
      scroll-snap-align: start;
      padding: 0.64rem 0.68rem;
      border-top: 0 !important;
      border-right: 1px solid #d7d9d5 !important;
    }

    .category-rail a:last-child {
      border-right: 0 !important;
    }

    .home-tools {
      margin-top: var(--space-5);
    }

    .home-tools__header {
      display: block;
    }

    .home-tools__header > p {
      margin-top: 0.5rem;
    }

    .tool-column,
    .tool-columns {
      gap: var(--space-4);
    }

    .tool-group {
      border-radius: 4px;
    }

    .tool-link {
      gap: 0.58rem;
      padding: 0.72rem 0.66rem;
    }
  }
</style>
