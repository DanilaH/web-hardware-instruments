www.hardwareinspect.com {
  redir https://hardwareinspect.com{uri} 308
}

hardwareinspect.com {
  root * /srv/hardwareinspect/current
  encode zstd gzip

  # Astro emits extensionless routes as .html files in production.
  # Rewrite internally so /mouse-tester stays the public/canonical URL.
  try_files {path} {path}.html
  file_server

  handle_errors {
    rewrite * /404.html
    file_server
  }
}
