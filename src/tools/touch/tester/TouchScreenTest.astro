---
import ToolShell from '../../../components/tool-shell/ToolShell.astro';
import { touchGridCellCount } from './touch-test-state';

const cells = Array.from({ length: touchGridCellCount }, (_, index) => index);
---

<ToolShell labelledBy="touch-tool-heading">
  <h2 id="touch-tool-heading" class="touch-tool__sr">Touch Screen Test controls</h2>

  <div class="touch-tool" data-touch-screen-test data-state="ready" data-fullscreen="false">
    <div class="touch-tool__status-row">
      <span class="touch-tool__signal" aria-hidden="true"></span>
      <strong data-touch-status role="status" aria-live="polite">Checking touchscreen capability…</strong>
    </div>

    <p class="touch-tool__instruction">Touch and drag across the whole test area, including edges and corners.</p>

    <div class="touch-tool__metrics" aria-label="Touch test measurements">
      <div><span>Active touches</span><strong class="measurement-value" data-touch-active>0</strong></div>
      <div><span>Maximum detected together</span><strong class="measurement-value" data-touch-maximum>0</strong></div>
      <div class="touch-tool__metric--primary"><span>Coverage</span><strong class="measurement-value" data-touch-coverage>0%</strong></div>
    </div>

    <div class="touch-tool__surface" data-touch-surface aria-label="Touch coverage test area">
      <div class="touch-tool__grid" aria-hidden="true">
        {cells.map((index) => <span data-touch-cell={index} data-coverage="open"></span>)}
      </div>
      <svg class="touch-tool__overlay" data-touch-overlay viewBox="0 0 1000 625" preserveAspectRatio="none" aria-hidden="true"></svg>
      <span class="touch-tool__surface-label" aria-hidden="true">SWEEP THE WHOLE AREA</span>
    </div>

    <div class="touch-tool__actions">
      <button type="button" class="touch-action" data-touch-confirmation>Check missed areas</button>
      <button type="button" class="touch-action" data-touch-reset>Reset coverage</button>
      <button type="button" class="touch-action" data-touch-fullscreen>Full screen</button>
      <span class="touch-tool__fullscreen-note" data-touch-fullscreen-note aria-live="polite"></span>
    </div>

    <p class="touch-tool__confirmation" data-touch-confirmation-summary hidden></p>

    <section class="hands-off" aria-labelledby="hands-off-heading">
      <div>
        <h3 id="hands-off-heading">Hands-off unexpected-touch check</h3>
        <p data-touch-hands-off-result>Optional: run a separate 15-second hands-off observation.</p>
      </div>
      <button type="button" class="touch-action" data-touch-hands-off>Run hands-off check</button>
    </section>

    <details class="touch-tool__details">
      <summary>Details</summary>
      <p>Device-reported maximum touch points: <strong data-touch-reported-maximum>—</strong></p>
      <p>Coverage describes this browser test area only. Mouse and stylus input do not count as finger touch.</p>
    </details>
  </div>
</ToolShell>

<script>
  import { mountTouchScreenTest } from './touch-screen-controller';

  const root = document.querySelector<HTMLElement>('[data-touch-screen-test]');
  if (root) {
    const controller = mountTouchScreenTest(root);
    window.addEventListener('pagehide', (event) => {
      if (event.persisted) {
        controller.stop();
        return;
      }
      controller.destroy();
    });
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) controller.start();
    });
  }
</script>

<style>
  .touch-tool {
    display: grid;
    gap: var(--space-4);
  }

  .touch-tool__status-row {
    min-height: 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    color: var(--color-muted);
    font-size: 0.86rem;
  }

  .touch-tool__status-row strong {
    color: var(--color-text);
  }

  .touch-tool__signal {
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.35rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-signal);
  }

  .touch-tool[data-state='unavailable'] .touch-tool__signal {
    background: #aeb4b7;
  }

  .touch-tool__instruction,
  .touch-tool__confirmation,
  .hands-off p,
  .touch-tool__details p {
    margin: 0;
  }

  .touch-tool__instruction {
    font-size: 0.95rem;
  }

  .touch-tool__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .touch-tool__metrics > div {
    min-width: 0;
    display: grid;
    gap: 0.2rem;
    border-top: 1px solid #e3e6e7;
    padding-top: var(--space-3);
  }

  .touch-tool__metrics span {
    color: var(--color-muted);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.055em;
  }

  .touch-tool__metrics strong {
    font-size: clamp(1.45rem, 4vw, 2.35rem);
    line-height: 1;
  }

  .touch-tool__metric--primary strong {
    color: var(--color-signal);
  }

  .touch-tool__surface {
    position: relative;
    min-height: 17rem;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid #d9dddf;
    background: #fafbfb;
    touch-action: none;
    user-select: none;
  }

  .touch-tool__grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(16, 1fr);
    grid-template-rows: repeat(10, 1fr);
  }

  .touch-tool__grid span {
    border-right: 1px solid #edf0f1;
    border-bottom: 1px solid #edf0f1;
    background: transparent;
    transition: background 100ms ease, box-shadow 100ms ease;
  }

  .touch-tool__grid span[data-coverage='covered'],
  .touch-tool__grid span[data-coverage='confirmed'] {
    background: color-mix(in srgb, var(--color-signal) 16%, transparent);
  }

  .touch-tool__grid span[data-coverage='pass1'] {
    background: #f1f3f3;
  }

  .touch-tool__grid span[data-coverage='target'] {
    background: repeating-linear-gradient(135deg, #f5f6f6 0 5px, #ecefef 5px 6px);
    box-shadow: inset 0 0 0 1px #d8ddde;
  }

  .touch-tool__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .touch-tool__overlay :global(.touch-overlay__trail) {
    fill: none;
    stroke: var(--color-signal);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.42;
  }

  .touch-tool__overlay :global(.touch-overlay__marker) {
    fill: color-mix(in srgb, var(--color-signal) 24%, white);
    stroke: var(--color-signal);
    stroke-width: 4;
  }

  .touch-tool__overlay :global(.touch-overlay__unexpected) {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 4;
  }

  .touch-tool__surface-label {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: #b0b5b7;
    font: 600 0.68rem var(--font-mono);
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  .touch-tool__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .touch-action {
    min-height: 2.35rem;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    background: #fff;
    padding: 0.5rem 0.75rem;
    color: var(--color-text);
    cursor: pointer;
  }

  .touch-action:disabled {
    cursor: not-allowed;
    opacity: 0.48;
  }

  .touch-tool__fullscreen-note {
    color: var(--color-muted);
    font-size: 0.76rem;
  }

  .touch-tool__confirmation {
    border-left: 2px solid var(--color-border);
    padding-left: var(--space-3);
    color: var(--color-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .hands-off {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-top: 1px solid #e3e6e7;
    padding-top: var(--space-4);
  }

  .hands-off h3 {
    margin: 0 0 0.2rem;
    font-size: 0.9rem;
  }

  .hands-off p,
  .touch-tool__details {
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .touch-tool__details summary {
    cursor: pointer;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .touch-tool__details p {
    margin-top: var(--space-2);
  }

  .touch-tool:fullscreen {
    min-height: 100vh;
    overflow: auto;
    background: var(--color-surface);
    padding: clamp(1rem, 3vw, 2rem);
  }

  .touch-tool:fullscreen .touch-tool__surface {
    min-height: min(58vh, 42rem);
  }

  .touch-tool__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 40rem) {
    .touch-tool {
      gap: var(--space-3);
    }

    .touch-tool__metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-2);
    }

    .touch-tool__metrics span {
      font-size: 0.6rem;
    }

    .touch-tool__surface {
      min-height: 12rem;
      aspect-ratio: 16 / 10;
    }

    .touch-tool__actions {
      gap: 0.4rem;
    }

    .touch-action {
      min-height: 2.2rem;
      padding: 0.45rem 0.6rem;
      font-size: 0.82rem;
    }

    .hands-off {
      align-items: stretch;
      flex-direction: column;
      gap: var(--space-2);
    }

    .hands-off .touch-action {
      align-self: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .touch-tool__grid span {
      transition: none;
    }
  }
</style>
