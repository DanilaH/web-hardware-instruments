---
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  headerVariant?: 'default' | 'homepage';
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  headerVariant = 'default',
} = Astro.props;

const effectiveNoindex = noindex || !siteConfig.indexingEnabled;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={effectiveNoindex}
    />
  </head>
  <body>
    <SiteHeader variant={headerVariant} />
    <main class:list={['page-main', headerVariant === 'homepage' && 'page-main--homepage']}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .page-main--homepage {
    padding-top: var(--space-4);
  }

  @media (max-width: 40rem) {
    .page-main--homepage {
      padding-top: var(--space-3);
    }
  }
</style>
