---
import ToolShell from '../../../components/tool-shell/ToolShell.astro';
---
<ToolShell labelledBy="scroll-test-heading">
  <h2 id="scroll-test-heading" class="sr-only">Mouse Scroll Test</h2>
  <div class="scroll-test" data-mouse-scroll-test>
    <div class="status"><span aria-hidden="true"></span><strong data-scroll-status role="status" aria-live="polite">Listening for wheel events</strong></div>
    <p class="instruction">Scroll steadily in one direction inside the test area, then repeat in the other direction.</p>
    <div class="surface" data-scroll-surface>
      <div class="strip" data-scroll-strip aria-label="Recent browser-detected wheel directions">Scroll inside the area</div>
      <div class="metrics"><div><span>Up events</span><strong data-scroll-up>0</strong></div><div><span>Down events</span><strong data-scroll-down>0</strong></div><div><span>Horizontal events</span><strong data-scroll-horizontal>0</strong></div></div>
      <button type="button" data-scroll-reset>Reset</button>
    </div>
    <p class="note">Counts are browser-detected wheel events, not physical wheel notches. Trackpads and other scrolling devices can also produce wheel events.</p>
  </div>
</ToolShell>
<script>
 import { mountMouseScrollTest } from './mouse-scroll-controller'; const root=document.querySelector<HTMLElement>('[data-mouse-scroll-test]'); if(root){const controller=mountMouseScrollTest(root);window.addEventListener('pagehide',(event)=>event.persisted?controller.stop():controller.destroy());window.addEventListener('pageshow',(event)=>{if(event.persisted)controller.start();});}
</script>
<style>
.scroll-test{display:grid;gap:var(--space-4)}.status{display:flex;gap:.55rem;align-items:center;color:var(--color-muted);font-size:.88rem}.status span{width:.55rem;height:.55rem;border-radius:50%;background:var(--color-signal)}.instruction,.note{margin:0}.surface{display:grid;gap:var(--space-4);padding:var(--space-5);border:1px solid #e3e6e7;background:#fafbfb}.strip{min-height:8rem;display:grid;place-items:center;padding:var(--space-4);border:1px solid #dfe3e4;background:#fff;color:var(--color-signal);font:600 clamp(1.1rem,2.5vw,1.7rem)/1.8 var(--font-mono);text-align:center;overflow-wrap:anywhere}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-3)}.metrics>div{min-width:0;display:grid;gap:.25rem;padding:var(--space-3);border:1px solid #e2e5e6;background:#fff}.metrics span{color:var(--color-muted);font-size:.72rem;font-weight:600;text-transform:uppercase}.metrics strong{font:600 1.35rem var(--font-mono)}button{justify-self:start;border:0;background:none;color:var(--color-muted);text-decoration:underline;cursor:pointer}.note{color:var(--color-muted);font-size:.75rem;line-height:1.45}.sr-only{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@media(max-width:40rem){.surface{padding:var(--space-3)}.metrics{gap:var(--space-2)}.metrics>div{padding:.65rem .5rem}.metrics span{font-size:.62rem;line-height:1.3}.metrics strong{font-size:1.15rem}.strip{min-height:6rem}}
</style>
