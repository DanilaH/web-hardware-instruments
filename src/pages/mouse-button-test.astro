---
import RelatedTools from '../components/navigation/RelatedTools.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import MouseButtonTest from '../tools/mouse/button/MouseButtonTest.astro';

const relatedTools = [
  {
    href: '/mouse-tester',
    name: 'Mouse Tester',
    description: 'Check buttons, wheel input, and movement together.',
  },
  {
    href: '/double-click-test',
    name: 'Double Click Test',
    description: 'Look for unusually fast repeated presses while clicking slowly.',
  },
] as const;
---

<BaseLayout
  title="Mouse Button Test — Check Mouse Buttons Online"
  description="Test primary, middle, secondary, back, and forward mouse button input directly in your browser."
  canonicalPath="/mouse-button-test"
>
  <section class="reading-width">
    <h1 class="page-heading">Mouse Button Test</h1>
    <p class="page-intro">Check each semantic mouse button role, including Back/X1 and Forward/X2.</p>
  </section>

  <MouseButtonTest />

  <section class="tool-content reading-width">
    <h2>How to test mouse buttons</h2>
    <p>
      Press each button inside the test area. Held highlighting shows the current browser state and the counter records observed button-down events. Primary is usually the left button and Secondary usually the right, but OS remapping can change those semantic roles.
    </p>

    <h2>Middle and side buttons</h2>
    <p>
      Back/X1 and Forward/X2 are additional browser button roles. The test listens for normal pointer presses and uses auxiliary-click events as a fallback for side buttons when available. Some browsers, operating systems, drivers, or mouse utilities can still consume those buttons before the page sees them, so a missing X1/X2 event is not an automatic hardware verdict.
    </p>
  </section>

  <RelatedTools tools={relatedTools} />
</BaseLayout>

<style>
  .tool-content {
    margin-top: var(--space-7);
    padding-bottom: var(--space-7);
  }

  .tool-content h2 {
    margin: var(--space-6) 0 var(--space-2);
    font-size: 1.15rem;
  }

  .tool-content p {
    color: var(--color-muted);
    line-height: 1.65;
  }
</style>
