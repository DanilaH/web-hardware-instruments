---
import ToolShell from '../../../components/tool-shell/ToolShell.astro';
import type { ImplementedContentLocale } from '../../../i18n/content';
import { getScreenResolutionRuntimeMessages } from '../../../i18n/runtime/screen-resolution';

interface Props { locale?: ImplementedContentLocale; }
const { locale = 'en' } = Astro.props;
const messages = getScreenResolutionRuntimeMessages(locale);
---

<ToolShell labelledBy="screen-resolution-tool-heading">
  <h2 id="screen-resolution-tool-heading" class="resolution-tool__sr">{messages.controlsHeading}</h2>

  <div class="resolution-tool" data-screen-resolution-checker>
    <div class="resolution-tool__status-row">
      <span class="resolution-tool__signal" aria-hidden="true"></span>
      <strong>{messages.browserReported}</strong>
    </div>

    <div class="resolution-tool__primary" aria-live="polite" aria-atomic="true">
      <span class="resolution-tool__label">{messages.screenSize}</span>
      <div class="resolution-tool__primary-value measurement-value">
        <output data-resolution-screen-size>— × —</output>
        <small>{messages.cssPixels}</small>
      </div>
    </div>

    <div class="resolution-tool__details">
      <div class="resolution-detail resolution-detail--estimate">
        <span>{messages.estimatedDevicePixels}</span>
        <strong class="measurement-value"><output data-resolution-device-pixels>— × —</output></strong>
        <small>{messages.estimated} · {messages.devicePixels}</small>
      </div>
      <div class="resolution-detail">
        <span>{messages.viewport}</span>
        <strong class="measurement-value"><output data-resolution-viewport>— × —</output></strong>
        <small>{messages.cssPixels}</small>
      </div>
      <div class="resolution-detail">
        <span>{messages.availableArea}</span>
        <strong class="measurement-value"><output data-resolution-available>— × —</output></strong>
        <small>{messages.cssPixels}</small>
      </div>
      <div class="resolution-detail">
        <span>{messages.devicePixelRatio}</span>
        <strong class="measurement-value"><output data-resolution-dpr>—</output></strong>
      </div>
      <div class="resolution-detail">
        <span>{messages.colorDepth}</span>
        <strong class="measurement-value"><output data-resolution-color-depth>—</output></strong>
        <small>{messages.bits}</small>
      </div>
      <div class="resolution-detail" data-resolution-orientation-row hidden>
        <span>{messages.orientation}</span>
        <strong class="measurement-value resolution-detail__orientation"><output data-resolution-orientation>—</output></strong>
      </div>
    </div>
  </div>
</ToolShell>

<script>
  import { mountScreenResolutionChecker } from './screen-resolution-controller';

  const root = document.querySelector<HTMLElement>('[data-screen-resolution-checker]');
  if (root) {
    const controller = mountScreenResolutionChecker(root);
    window.addEventListener('pagehide', (event) => {
      if (event.persisted) {
        controller.stop();
        return;
      }
      controller.destroy();
    });
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) controller.start();
    });
  }
</script>

<style>
  .resolution-tool { display: grid; gap: var(--space-4); }
  .resolution-tool__status-row { min-height: 1.5rem; display: flex; align-items: center; gap: 0.55rem; color: var(--color-muted); font-size: 0.85rem; }
  .resolution-tool__status-row strong { color: var(--color-text); font-size: 0.9rem; }
  .resolution-tool__signal { width: 0.55rem; height: 0.55rem; flex: 0 0 auto; border-radius: 50%; background: var(--color-signal); }
  .resolution-tool__primary { padding-block: var(--space-3) var(--space-5); border-block: 1px solid #e3e6e7; }
  .resolution-tool__label, .resolution-detail span, .resolution-detail small { color: var(--color-muted); }
  .resolution-tool__label { font-size: 0.82rem; }
  .resolution-tool__primary-value { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.55rem; margin-top: 0.35rem; font-size: clamp(2.9rem, 6vw, 5rem); font-weight: 700; line-height: 0.95; letter-spacing: -0.055em; }
  .resolution-tool__primary-value small { color: var(--color-muted); font-size: 0.82rem; font-weight: 500; letter-spacing: 0; }
  .resolution-tool__details { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid #e3e6e7; }
  .resolution-detail { min-width: 0; min-height: 6.1rem; display: grid; align-content: center; gap: 0.28rem; padding: var(--space-3) var(--space-4); border-right: 1px solid #e3e6e7; border-bottom: 1px solid #e3e6e7; }
  .resolution-detail:nth-child(3n) { border-right: 0; }
  .resolution-detail:nth-last-child(-n + 3) { border-bottom: 0; }
  .resolution-detail span, .resolution-detail small { font-size: 0.72rem; }
  .resolution-detail strong { min-width: 0; font-size: 1.35rem; line-height: 1.1; overflow-wrap: anywhere; }
  .resolution-detail--estimate { background: #fafbfb; }
  .resolution-detail__orientation { font-size: 1rem !important; }
  .resolution-tool__sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 48rem) {
    .resolution-tool__details { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .resolution-detail, .resolution-detail:nth-child(3n) { border-right: 1px solid #e3e6e7; border-bottom: 1px solid #e3e6e7; }
    .resolution-detail:nth-child(2n) { border-right: 0; }
    .resolution-detail:nth-last-child(-n + 2) { border-bottom: 0; }
    .resolution-tool__primary-value { font-size: clamp(2.35rem, 11vw, 3.6rem); }
  }

  @media (max-width: 28rem) {
    .resolution-tool__details { grid-template-columns: 1fr; }
    .resolution-detail, .resolution-detail:nth-child(2n), .resolution-detail:nth-child(3n) { border-right: 0; border-bottom: 1px solid #e3e6e7; }
    .resolution-detail:last-child { border-bottom: 0; }
  }
</style>
